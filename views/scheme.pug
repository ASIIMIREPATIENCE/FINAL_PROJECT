doctype html
html(lang='en')
head
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1.0')
  title NyondoStock - Deposit Scheme Management
  link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css' rel='stylesheet')
  link(rel='stylesheet' href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css')
  link(rel='stylesheet' href='/css/scheme.css')

body
  .sidebar
    .sidebar-logo
      img(src='/images/logo.png' alt='Logo')
      h3 NyondoStock
      p Hardware Management

    .sidebar-back-btn
      button.btn-back(onclick="history.back()")
        i.bi.bi-arrow-left
        | Back

    .sidebar-user
      .user-name 👤 #{currentUser ? currentUser.fullname : 'Guest User'}
      .user-role #{currentUser ? (currentUser.role === 'admin' ? 'System Administrator' : (currentUser.role === 'store_manager' ? 'Store Manager' : 'Sales Attendant')) : 'Guest User'}
      button.logout-btn(onclick="window.location.href='/logout'")
        i.bi.bi-box-arrow-right
        | Sign Out

  .main-content
    .d-flex.justify-content-between.align-items-center.flex-wrap.mb-3
      div
        h3(style='color: var(--nyondo-green); font-weight: 700; margin: 0;') Deposit Scheme Management
        p(style='color: #6c757d; margin: 5px 0 0 0; font-size: 0.8rem;') Register depositors and track their savings progress

    if messages && messages.success
      .alert.alert-success.alert-dismissible.fade.show(role='alert')
        i.bi.bi-check-circle-fill.me-2
        | #{messages.success}
        button.btn-close(type='button' data-bs-dismiss='alert')
    if messages && messages.error
      .alert.alert-danger.alert-dismissible.fade.show(role='alert')
        i.bi.bi-exclamation-triangle-fill.me-2
        | #{messages.error}
        button.btn-close(type='button' data-bs-dismiss='alert')
    
    // Summary Cards
    .row.g-3.mb-4
      .col-md-4
        .summary-card
          div(style='font-size: 0.7rem; opacity: 0.8;') Total Depositors
          .summary-value #{depositorsCount}
          small(style='opacity: 0.7;') Registered members
      .col-md-4
        .summary-card(style='background: linear-gradient(135deg, #C6A43F 0%, #B8922E 100%);')
          div(style='font-size: 0.7rem; opacity: 0.8;') Total Savings Target
          .summary-value(style='color: #0D3B2E;') UGX #{totalSavingsTarget ? totalSavingsTarget.toLocaleString() : '0'}
          small(style='opacity: 0.8;') Combined target amount
      .col-md-4
        .summary-card(style='background: linear-gradient(135deg, #2E7D64 0%, #236854 100%);')
          div(style='font-size: 0.7rem; opacity: 0.8;') Total Amount Paid
          .summary-value UGX #{totalAmountPaid ? totalAmountPaid.toLocaleString() : '0'}
          small(style='opacity: 0.8;') Total deposits received

    // Register New Depositor Form
    .form-card
      .form-title
        i.bi.bi-person-plus(style='color: #C6A43F;')
        | Register New Depositor
      form(action='/registerDepositor' method='post' novalidate)
        .row.g-3
          .col-md-3
            label.form-label Full Name
            input#fullName.form-control(type='text' name='fullName' placeholder='Enter full name')
            .invalid-feedback Full name is required
          .col-md-2
            label.form-label Phone Number
            input#phoneNumber.form-control(type='tel' name='phoneNumber' value='+256')
            .invalid-feedback Use +256XXXXXXXXX or 0XXXXXXXXX

          .col-md-2
            label.form-label NIN
            input#nin.form-control(type='text' name='nin' placeholder='Enter NIN')
            .invalid-feedback NIN must be CFXXXXXXXXXXXX or CMXXXXXXXXXXXX

          .col-md-3
            label.form-label Employer 
            input#employer.form-control(type='text' name='employer' placeholder='Company name')
            .valid-feedback Optional field
        
        // Items Selection Section
        .row.g-3.mt-3
          .col-md-12
            .form-title(style='font-size: 0.9rem;')
              i.bi.bi-cart(style='color: #C6A43F;')
              | Items Being Purchased
        
        .row.g-3
          .col-md-4
            label.form-label Select Item
            select#itemSelect.form-select
              option(value='' disabled selected) Select an item
              each item in stockItems
                option(value=item.productname data-price=item.sellingprice)= `${item.productname} (UGX ${item.sellingprice.toLocaleString()})`
            .invalid-feedback Please select an item

          .col-md-2
            label.form-label Quantity
            input#itemQuantity.form-control(type='number' value='1' min='1')
            .invalid-feedback Quantity must be at least 1

          .col-md-2
            label.form-label Unit Price (UGX)
            input#itemPrice.form-control(type='number' placeholder='Enter price')
            .invalid-feedback Valid unit price is required

          .col-md-2
            label.form-label &nbsp;
            button#addItemBtn.btn.btn-warning(type='button' style='background:#C6A43F; color:white; width:100%')
              i.bi.bi-cart-plus
              | Add Item
        
        .table-responsive.mt-3
          table.table
            thead
              tr
                th Item
                th Qty
                th Price
                th Subtotal
                th
            tbody#itemsCartBody
              tr
                td(colspan='5' class='text-center text-muted') No items added
        
        // Transport Section
        .row.g-3.mt-3
          .col-md-12
            .form-title(style='font-size: 0.9rem;')
              i.bi.bi-truck(style='color: #C6A43F;')
              | Transport Information
        
        .row.g-3
          .col-md-4
            .form-check
              input#needTransport.form-check-input(type='checkbox' name='needTransport' value='true')
              label.form-check-label Need Transport Delivery?
          .col-md-3
            label.form-label Distance (km)
            input#distanceKm.form-control(type='number' name='distance' value='0' min='0')
            .invalid-feedback Please enter a valid distance (1-100 km)
            
        
        // Totals Section
        .row.mt-3
          .col-md-6.offset-md-6
            table.table.table-borderless
              tr
                td Items Subtotal:
                td.text-end UGX <span id="itemsSubtotal">0</span>
              tr
                td Transport Fee:
                td.text-end UGX <span id="transportFeeDisplay">0</span>
              tr(style='border-top: 2px solid #dee2e6;')
                td TOTAL AMOUNT OWED:
                td.text-end UGX <span id="totalAmount">0</span>
        
        input#cartItems(type='hidden' name='cartItems')
        
        .row.mt-3
          .col-md-12
            button.btn-save.w-100(type='submit')
              i.bi.bi-save
              | REGISTER DEPOSITOR

    // Record Deposit Form
    .form-card
      .form-title
        i.bi.bi-cash(style='color: #C6A43F;')
        | Record Deposit Payment
      form(action='/recordDeposit' method='post' novalidate)
        .row.g-3
          .col-md-4
            label.form-label Select Depositor
            select#depositorSelect.form-select(name='depositorId')
              option(value='') Select depositor...
              each depositor in depositors
                option(value=depositor._id) #{depositor.fullName} - Remaining: UGX #{depositor.remainingBalance.toLocaleString()}
            .invalid-feedback Please select a depositor

          .col-md-2
            label.form-label Amount Paying (UGX)
            input#amountPaid.form-control(type='number' name='amountPaid' placeholder='Amount' min='1000')
            .invalid-feedback Amount must be at least UGX 1,000

          .col-md-2
            label.form-label Payment Method
            select#paymentMethodSelect.form-select(name='paymentMethod')
              option(value='') Select payment method
              option(value='Cash') Cash
              option(value='Bank Transfer') Bank Transfer
              option(value='Mobile Money') Mobile Money
            .invalid-feedback Please select payment method
            .valid-feedback Payment method selected!
          .col-md-3
            label.form-label Notes (Optional)
            input.form-control(type='text' name='notes' placeholder='Reference or notes')
          .col-md-1.d-flex.align-items-end
            button.btn-save.w-100(type='submit')
              i.bi.bi-check-circle
              | Pay

    // Registered Depositors Table with Pickup Status
    .section-title
      i.bi.bi-people
      | Registered Depositors
    .custom-table
      table
        thead
          tr
            th Date Registered
            th Name
            th Phone
            th NIN
            th Items
            th Total Owed (UGX)
            th Total Paid (UGX)
            th Remaining Balance (UGX)
            th Pickup Status
            th Status
            th Actions
        tbody
          if depositors && depositors.length
            each depositor in depositors
              - var remaining = depositor.totalAmountOwed - depositor.totalPaid
              - var pickupStatus = depositor.pickupStatus || 'pending'
              tr
                td #{depositor.joinDate ? new Date(depositor.joinDate).toLocaleDateString() : 'N/A'}
                td #{depositor.fullName}
                td #{depositor.phoneNumber}
                td #{depositor.nin}
                td 
                  if depositor.items && depositor.items.length
                    each item, idx in depositor.items.slice(0, 2)
                      | #{item.productname} (x#{item.quantity})
                      if idx < depositor.items.slice(0, 2).length - 1
                        | , 
                    if depositor.items.length > 2
                      |  +#{depositor.items.length - 2} more
                  else
                    | -
                td UGX #{depositor.totalAmountOwed ? depositor.totalAmountOwed.toLocaleString() : '0'}
                td UGX #{depositor.totalPaid ? depositor.totalPaid.toLocaleString() : '0'}
                td 
                  if remaining <= 0
                    span(style='color: #28a745; font-weight: bold;') PAID
                  else
                    span(style='color: #dc3545; font-weight: bold;') UGX #{remaining.toLocaleString()}
                td
                  if pickupStatus === 'picked_up'
                    span.badge(style='background: #28a745; color: white;') Picked Up
                  else if pickupStatus === 'ready'
                    span.badge(style='background: #ffc107; color: black;') Ready for Pickup
                  else if remaining <= 0
                    span.badge(style='background: #17a2b8; color: white;') Awaiting Pickup
                  else
                    span.badge(style='background: #6c757d; color: white;') Payment Pending
                td
                  if depositor.status === 'picked_up'
                    span.badge(style='background: #28a745; color: white;') Completed
                  else if depositor.status === 'completed'
                    span.badge(style='background: #17a2b8; color: white;') Paid - Ready
                  else if depositor.status === 'active'
                    span.badge(style='background: #ffc107; color: black;') In Progress
                  else
                    span.badge(style='background: #dc3545; color: white;') #{depositor.status}
                td
                  .action-buttons(style='display: flex; gap: 5px; flex-wrap: wrap;')
                    button.btn-sm.btn-info(type='button' data-bs-toggle='modal' data-bs-target=`#historyModal${depositor._id}`)
                      i.bi.bi-clock-history
                      | View
                    
                    if remaining <= 0 && pickupStatus === 'pending'
                      form(action=`/mark-ready/${depositor._id}` method='POST' style='display: inline;')
                        button.btn-sm.btn-warning(type='submit' style='background: #ffc107; color: black;' onclick='return confirm("Mark these goods as ready for pickup?")')
                          i.bi.bi-check-circle
                          | Mark Ready
                    
                    if pickupStatus === 'ready'
                      button.btn-sm.btn-success(type='button' data-bs-toggle='modal' data-bs-target=`#pickupModal${depositor._id}`)
                        i.bi.bi-truck
                        | Record Pickup
                      
                      form(action=`/cancel-pickup/${depositor._id}` method='POST' style='display: inline;')
                        button.btn-sm.btn-danger(type='submit' onclick='return confirm("Cancel ready status?")')
                          i.bi.bi-x-circle
                          | Cancel
          else
            tr
              td.text-center(colspan='11') No depositors registered yet

    // Deposit Transactions Table
    .section-title.mt-4
      i.bi.bi-clock-history
      | Deposit Transaction History
    .custom-table
      table
        thead
          tr
            th Date
            th Depositor
            th Total Owed (UGX)
            th Amount Paid (UGX)
            th Balance After (UGX)
            th Payment Method
            th Attendant
        tbody
          if recentTransactions && recentTransactions.length
            each transaction in recentTransactions
              tr
                td #{transaction.date ? new Date(transaction.date).toLocaleString() : 'N/A'}
                td #{transaction.depositorName}
                td UGX #{transaction.totalOwed ? transaction.totalOwed.toLocaleString() : '0'}
                td UGX #{transaction.amountPaid ? transaction.amountPaid.toLocaleString() : '0'}
                td UGX #{transaction.balanceAfter ? transaction.balanceAfter.toLocaleString() : '0'}
                td #{transaction.paymentMethod || 'Cash'}
                td #{transaction.attendantName || 'unknown'}
          else
            tr
              td.text-center(colspan='7') No deposit transactions recorded yet

  // Pickup Record Modal
  each depositor in depositors
    .modal.fade(id=`pickupModal${depositor._id}` tabindex='-1')
      .modal-dialog
        .modal-content
          .modal-header
            h5.modal-title Record Pickup - #{depositor.fullName}
            button.btn-close(type='button' data-bs-dismiss='modal')
          form(action=`/record-pickup/${depositor._id}` method='POST')
            .modal-body
              .mb-3
                label.form-label Picked Up By
                input.form-control(type='text' name='pickedUpBy' placeholder="Customer's name or representative" required)
              .mb-3
                label.form-label Notes (Optional)
                textarea.form-control(name='notes' rows='3' placeholder='Any additional notes about the pickup...')
              .alert.alert-info
                i.bi.bi-info-circle.me-2
                strong Items to be picked up:
                ul.mt-2.mb-0
                  each item in depositor.items
                    li #{item.productname} (x#{item.quantity})
            .modal-footer
              button.btn.btn-secondary(type='button' data-bs-dismiss='modal') Cancel
              button.btn.btn-success(type='submit')
                i.bi.bi-truck
                | Confirm Pickup

  // History Modal
  each depositor in depositors
    .modal.fade(id=`historyModal${depositor._id}` tabindex='-1')
      .modal-dialog.modal-lg
        .modal-content
          .modal-header
            h5.modal-title Transaction History - #{depositor.fullName}
            button.btn-close(type='button' data-bs-dismiss='modal')
          .modal-body
            // Deposit History
            if depositor.depositHistory && depositor.depositHistory.length
              h6 Deposit History
              .table-responsive
                table.table.table-sm
                  thead
                    tr
                      th Date
                      th Amount Paid
                      th Balance After
                      th Payment Method
                      th Attendant
                  tbody
                    each transaction in depositor.depositHistory.slice().reverse()
                      tr
                        td #{transaction.date ? new Date(transaction.date).toLocaleString() : 'N/A'}
                        td UGX #{transaction.amountPaid.toLocaleString()}
                        td UGX #{transaction.balanceAfter.toLocaleString()}
                        td #{transaction.paymentMethod || 'Cash'}
                        td #{transaction.attendantName || 'unknown'}
            else
              p No deposit history found.
            
            // Pickup History
            if depositor.pickupHistory && depositor.pickupHistory.length
              h6.mt-3 Pickup History
              .table-responsive
                table.table.table-sm
                  thead
                    tr
                      th Date
                      th Action
                      th Attendant
                      th Notes
                  tbody
                    each pickup in depositor.pickupHistory.slice().reverse()
                      tr
                        td #{pickup.date ? new Date(pickup.date).toLocaleString() : 'N/A'}
                        td
                          if pickup.action === 'marked_ready'
                            span.badge(style='background: #ffc107; color: black;') Marked Ready
                          else if pickup.action === 'picked_up'
                            span.badge(style='background: #28a745; color: white;') Picked Up
                          else
                            span.badge(style='background: #dc3545; color: white;') Cancelled
                        td #{pickup.attendantName || 'unknown'}
                        td #{pickup.notes || '-'}

  .footer
    i.bi.bi-shield-check
    | NyondoStock — Enterprise Hardware Management System

  script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js')
  script(src='/js/scheme_cart.js?v=2')