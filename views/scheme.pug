doctype html
html(lang='en')
head
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1.0')
  title NyondoStock - Deposit Scheme Management
  link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css' rel='stylesheet')
  link(rel='stylesheet' href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css')
  link(rel='stylesheet' href='/css/scheme.css')

body
  .sidebar
    .sidebar-logo
      img(src='/images/logo.png' alt='Logo')
      h3 NyondoStock
      p Hardware Management

    .sidebar-back-btn
      button.btn-back(onclick="history.back()")
        i.bi.bi-arrow-left
        | Back

    .sidebar-user
      .user-name 👤 #{currentUser ? currentUser.fullname : 'Guest User'}
      .user-role #{currentUser ? (currentUser.role === 'admin' ? 'System Administrator' : (currentUser.role === 'store_manager' ? 'Store Manager' : 'Sales Attendant')) : 'Guest User'}
      button.logout-btn(onclick="window.location.href='/logout'")
        i.bi.bi-box-arrow-right
        | Sign Out

  .main-content
    .d-flex.justify-content-between.align-items-center.flex-wrap.mb-3
      div
        h3(style='color: var(--nyondo-green); font-weight: 700; margin: 0;') Deposit Scheme Management
        p(style='color: #6c757d; margin: 5px 0 0 0; font-size: 0.8rem;') Register depositors and track their savings progress

    if messages && messages.success
      .alert.alert-success.alert-dismissible.fade.show(role='alert')
        i.bi.bi-check-circle-fill.me-2
        | #{messages.success}
        button.btn-close(type='button' data-bs-dismiss='alert')
    if messages && messages.error
      .alert.alert-danger.alert-dismissible.fade.show(role='alert')
        i.bi.bi-exclamation-triangle-fill.me-2
        | #{messages.error}
        button.btn-close(type='button' data-bs-dismiss='alert')
    
    // Summary Cards
    .row.g-3.mb-4
      .col-md-4
        .summary-card
          div(style='font-size: 0.7rem; opacity: 0.8;') Total Depositors
          .summary-value #{depositorsCount}
          small(style='opacity: 0.7;') Registered members
      .col-md-4
        .summary-card(style='background: linear-gradient(135deg, #C6A43F 0%, #B8922E 100%);')
          div(style='font-size: 0.7rem; opacity: 0.8;') Total Savings Target
          .summary-value(style='color: #0D3B2E;') UGX #{totalSavingsTarget ? totalSavingsTarget.toLocaleString() : '0'}
          small(style='opacity: 0.8;') Combined target amount
      .col-md-4
        .summary-card(style='background: linear-gradient(135deg, #2E7D64 0%, #236854 100%);')
          div(style='font-size: 0.7rem; opacity: 0.8;') Total Amount Paid
          .summary-value UGX #{totalAmountPaid ? totalAmountPaid.toLocaleString() : '0'}
          small(style='opacity: 0.8;') Total deposits received

    // Register New Depositor Form
    .form-card
      .form-title
        i.bi.bi-person-plus(style='color: #C6A43F;')
        | Register New Depositor
      form(action='/registerDepositor' method='post')
        .row.g-3
          .col-md-3
            label.form-label Full Name
            input.form-control(type='text' name='fullName' placeholder='Enter full name' required)
          .col-md-2
            label.form-label Phone Number
            input.form-control(type='tel' name='phoneNumber' placeholder='+256XXXXXXXXX' required)
          .col-md-2
            label.form-label NIN
            input.form-control(type='text' name='nin' placeholder='Enter NIN' required)
          .col-md-2
            label.form-label Employer (Optional)
            input.form-control(type='text' name='employer' placeholder='Company name')
        
        // Items Selection Section
        .row.g-3.mt-3
          .col-md-12
            .form-title(style='font-size: 0.9rem;')
              i.bi.bi-cart(style='color: #C6A43F;')
              | Items Being Purchased
        
        .row.g-3
          .col-md-4
            label.form-label Select Item
            select#itemSelect.form-select
              option(value='' disabled selected) Select an item
              each item in stockItems
                option(value=item.productname data-price=item.sellingprice)= `${item.productname} (UGX ${item.sellingprice.toLocaleString()})`
          .col-md-2
            label.form-label Quantity
            input#itemQuantity.form-control(type='number' value='1' min='1')
          .col-md-2
            label.form-label Unit Price (UGX)
            input#itemPrice.form-control(type='number' placeholder='Enter price')
          .col-md-2
            label.form-label &nbsp;
            button#addItemBtn.btn.btn-warning(type='button' style='background:#C6A43F; color:white; width:100%')
              i.bi.bi-cart-plus
              | Add Item
        
        .table-responsive.mt-3
          table.table
            thead
              tr
                th Item
                th Qty
                th Price
                th Subtotal
                th
            tbody#itemsCartBody
              tr
                td(colspan='5' class='text-center text-muted') No items added
        
        // Transport Section
        .row.g-3.mt-3
          .col-md-12
            .form-title(style='font-size: 0.9rem;')
              i.bi.bi-truck(style='color: #C6A43F;')
              | Transport Information
        
        .row.g-3
          .col-md-4
            .form-check
              input#needTransport.form-check-input(type='checkbox' name='needTransport' value='true')
              label.form-check-label Need Transport Delivery?
          .col-md-3
            label.form-label Distance (km)
            input#distanceKm.form-control(type='number' name='distance' value='0' min='0')
        
        // Totals Section
        .row.mt-3
          .col-md-6.offset-md-6
            table.table.table-borderless
              tr
                td Items Subtotal:
                td.text-end UGX <span id="itemsSubtotal">0</span>
              tr
                td Transport Fee:
                td.text-end UGX <span id="transportFeeDisplay">0</span>
              tr(style='border-top: 2px solid #dee2e6;')
                td TOTAL AMOUNT OWED:
                td.text-end UGX <span id="totalAmount">0</span>
        
        input#cartItems(type='hidden' name='cartItems')
        
        .row.mt-3
          .col-md-12
            button.btn-save.w-100(type='submit')
              i.bi.bi-save
              | REGISTER DEPOSITOR

    // Record Deposit Form
    .form-card
      .form-title
        i.bi.bi-cash(style='color: #C6A43F;')
        | Record Deposit Payment
      form(action='/recordDeposit' method='post')
        .row.g-3
          .col-md-4
            label.form-label Select Depositor
            select.form-select(name='depositorId' required)
              option(value='') Select depositor...
              each depositor in depositors
                option(value=depositor._id) #{depositor.fullName} - #{depositor.savingFor} - Remaining: UGX #{depositor.remainingBalance.toLocaleString()}
          .col-md-2
            label.form-label Amount Paying (UGX)
            input.form-control(type='number' name='amountPaid' placeholder='Amount' required min='1000')
          .col-md-2
            label.form-label Payment Method
            select.form-select(name='paymentMethod')
              option(value='Cash') Cash
              option(value='Bank Transfer') Bank Transfer
              option(value='Mobile Money') Mobile Money
          .col-md-3
            label.form-label Notes (Optional)
            input.form-control(type='text' name='notes' placeholder='Reference or notes')
          .col-md-1.d-flex.align-items-end
            button.btn-save.w-100(type='submit')
              i.bi.bi-check-circle
              | Pay

    // Registered Depositors Table
    .section-title
      i.bi.bi-people
      | Registered Depositors
    .custom-table
      table
        thead
          tr
            th Date Registered
            th Name
            th Phone
            th NIN
            th Items
            th Total Owed (UGX)
            th Total Paid (UGX)
            th Remaining Balance (UGX)
            th Status
        tbody
          if depositors && depositors.length
            each depositor in depositors
              - var remaining = depositor.totalAmountOwed - depositor.totalPaid
              tr
                td #{depositor.joinDate ? new Date(depositor.joinDate).toLocaleDateString() : 'N/A'}
                td #{depositor.fullName}
                td #{depositor.phoneNumber}
                td #{depositor.nin}
                td 
                  if depositor.items && depositor.items.length
                    each item, idx in depositor.items.slice(0, 2)
                      | #{item.productname} (x#{item.quantity})
                      if idx < depositor.items.slice(0, 2).length - 1
                        | , 
                    if depositor.items.length > 2
                      |  +#{depositor.items.length - 2} more
                  else
                    | -
                td UGX #{depositor.totalAmountOwed ? depositor.totalAmountOwed.toLocaleString() : '0'}
                td UGX #{depositor.totalPaid ? depositor.totalPaid.toLocaleString() : '0'}
                td 
                  if remaining <= 0
                    span(style='color: #28a745; font-weight: bold;') PAID
                  else
                    span(style='color: #dc3545; font-weight: bold;') UGX #{remaining.toLocaleString()}
                td
                  if remaining <= 0
                    span.badge(style='background: #28a745; color: white;') Completed
                  else if depositor.totalPaid > 0
                    span.badge(style='background: #ffc107; color: black;') In Progress
                  else
                    span.badge(style='background: #dc3545; color: white;') Pending
          else
            tr
              td.text-center(colspan='10') No depositors registered yet

    // Deposit Transactions Table
    .section-title.mt-4
      i.bi.bi-clock-history
      | Deposit Transaction History
    .custom-table
      table
        thead
          tr
            th Date
            th Depositor
            th Total Owed (UGX)
            th Amount Paid (UGX)
            th Balance After (UGX)
            th Payment Method
            th Attendant
        tbody
          if recentTransactions && recentTransactions.length
            each transaction in recentTransactions
              tr
                td #{transaction.date ? new Date(transaction.date).toLocaleString() : 'N/A'}
                td #{transaction.depositorName}
                td UGX #{transaction.totalOwed ? transaction.totalOwed.toLocaleString() : '0'}
                td UGX #{transaction.amountPaid ? transaction.amountPaid.toLocaleString() : '0'}
                td UGX #{transaction.balanceAfter ? transaction.balanceAfter.toLocaleString() : '0'}
                td #{transaction.paymentMethod || 'Cash'}
                td #{transaction.attendantName || 'unknown'}
          else
            tr
              td.text-center(colspan='7') No deposit transactions recorded yet

  .footer
    i.bi.bi-shield-check
    | NyondoStock — Enterprise Hardware Management System

  script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js')
  script(src='/js/scheme_cart.js')