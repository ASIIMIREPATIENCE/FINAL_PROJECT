doctype html
html(lang='en')
head
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1.0')
  title NyondoStock - Deposit Scheme Management
  // Bootstrap 5 CSS + Icons
  link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css' rel='stylesheet')
  link(rel='stylesheet' href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css')
  link(rel='stylesheet' href='/css/scheme.css')

body
  // ========== SIDEBAR ==========
  .sidebar
    .sidebar-logo
      img(src='/images/logo.png' alt='Logo')
      h3 NyondoStock
      p Hardware Management
    ul.nav-menu
      li.nav-item
        a.nav-link-custom(href='#')
          i.bi.bi-speedometer2
          |  Dashboard
      li.nav-item
        a.nav-link-custom(href='#')
          i.bi.bi-box-seam
          |  Stock Management
      li.nav-item
        a.nav-link-custom(href='#')
          i.bi.bi-cart-plus
          |  Sales Recording
      li.nav-item
        a.nav-link-custom(href='#')
          i.bi.bi-clock-history
          |  Sales History
      li.nav-item
        a.nav-link-custom(href='#')
          i.bi.bi-credit-card
          |  Supplier Credit
      li.nav-item
        a.nav-link-custom.active(href='#')
          i.bi.bi-piggy-bank
          |  Deposit Scheme
      li.nav-item
        a.nav-link-custom(href='#')
          i.bi.bi-bar-chart-steps
          |  Reports
      li.nav-item
        a.nav-link-custom(href='#')
          i.bi.bi-people
          |  User Management
    .sidebar-user
      .user-name
        | 👤 Admin User 
        span.role-badge Admin
      .user-role System Administrator
      button.logout-btn
        i.bi.bi-box-arrow-right
        |  Sign Out

  // ========== MAIN CONTENT ==========
  .main-content
    .d-flex.justify-content-between.align-items-center.flex-wrap.mb-3
      div
        h3(style='color: var(--nyondo-green); font-weight: 700; margin: 0;') Salary-Earner Deposit Scheme
        p(style='color: #6c757d; margin: 5px 0 0 0; font-size: 0.8rem;') Manage customer deposits, withdrawals, and track balances.
    
    // Summary Cards
    .row.g-3.mb-4
      .col-md-4
        .summary-card
          div(style='font-size: 0.7rem; opacity: 0.8;') Total Deposits
          .summary-value UGX #{totalDeposits ? totalDeposits.toLocaleString() : '0'}
          small(style='opacity: 0.7;') Across #{depositorsCount} depositors
      .col-md-4
        .summary-card(style='background: linear-gradient(135deg, #C6A43F 0%, #B8922E 100%);')
          div(style='font-size: 0.7rem; opacity: 0.8;') Total Withdrawals
          .summary-value(style='color: #0D3B2E;') UGX #{totalWithdrawals ? totalWithdrawals.toLocaleString() : '0'}
          small(style='opacity: 0.8;') Year to date
      .col-md-4
        .summary-card(style='background: linear-gradient(135deg, #2E7D64 0%, #236854 100%);')
          div(style='font-size: 0.7rem; opacity: 0.8;') Current Balance
          .summary-value UGX #{currentBalance ? currentBalance.toLocaleString() : '0'}
          small(style='opacity: 0.8;') Total savings
    
    // Register New Depositor Form
    form(action='/registerDepositor' method='post')
      .form-card
        .form-title
          i.bi.bi-person-plus(style='color: #C6A43F;')
          |  Register New Depositor
          span.role-badge(style='background: #0D3B2E; color: white;') Admin Only
        .row.g-3
          .col-md-3
            label.form-label Full Name
            input.form-control(type='text' name='fullName' placeholder='Enter full name' required)
          .col-md-2
            label.form-label Phone Number
            input.form-control(type='tel' name='phoneNumber' placeholder='07XX XXX XXX' required)
          .col-md-2
            label.form-label NIN
            input.form-control(type='text' name='nin' placeholder='National ID' required)
          .col-md-3
            label.form-label Employer (Optional)
            input.form-control(type='text' name='employer' placeholder='Company name')
          .col-md-2.d-flex.align-items-end
            button.btn-save.w-100(type='submit')
              i.bi.bi-save
              |  Register
    
    // Record Transaction Form (Deposit/Withdrawal)
    form(action='/recordTransaction' method='post')
      .form-card
        .form-title
          i.bi.bi-cash-stack(style='color: #C6A43F;')
          |  Record Transaction
          span.role-badge(style='background: #0D3B2E; color: white;') Admin Only
        .row.g-3
          .col-md-3
            label.form-label Select Depositor
            select.form-select(name='depositorId' required)
              option(value='') Select depositor...
              each depositor in depositors
                option(value=depositor._id) #{depositor.fullName} - Balance: UGX #{depositor.currentBalance.toLocaleString()}
          .col-md-2
            label.form-label Transaction Type
            select.form-select(name='transactionType' required)
              option(value='Deposit') Deposit
              option(value='Withdrawal') Withdrawal
          .col-md-2
            label.form-label Amount (UGX)
            input.form-control(type='number' name='amount' placeholder='Amount' required)
          .col-md-2
            label.form-label Date
            input.form-control(type='date' name='date' required)
          .col-md-3.d-flex.align-items-end
            button.btn-save.w-100(type='submit')
              i.bi.bi-check-circle
              |  Record Transaction
    
    // Depositors Table
    .section-title
      i.bi.bi-people
      |  Registered Depositors
    .custom-table
      table
        thead
          tr
            th Name
            th Phone
            th NIN
            th Employer
            th Join Date
            th Current Balance
            th Actions
        tbody
          if depositors && depositors.length
            each depositor in depositors
              tr
                td #{depositor.fullName}
                td #{depositor.phoneNumber}
                td #{depositor.nin}
                td #{depositor.employer || 'N/A'}
                td #{new Date(depositor.joinDate).toLocaleDateString()}
                td.balance-positive UGX #{depositor.currentBalance.toLocaleString()}
                td
                  form(action='/recordTransaction' method='post' )
                    input(type='hidden' name='depositorId' value=depositor._id)
                    input(type='hidden' name='transactionType' value='Deposit')
                    input(type='hidden' name='date' value=new Date().toISOString().split('T')[0])
                    input.form-control(type='number' name='amount' placeholder='Amount' style='width: 100px; display: inline-block; margin-right: 5px;' required)
                    button.btn-deposit(type='submit')
                      i.bi.bi-cash
                      |  Deposit
                  form(action='/recordTransaction' method='post' style='display: inline-block;')
                    input(type='hidden' name='depositorId' value=depositor._id)
                    input(type='hidden' name='transactionType' value='Withdrawal')
                    input(type='hidden' name='date' value=new Date().toISOString().split('T')[0])
                    input.form-control(type='number' name='amount' placeholder='Amount' style='width: 100px; display: inline-block; margin-right: 5px;' required)
                    button.btn-withdraw(type='submit')
                      i.bi.bi-cash-stack
                      |  Withdraw
          else
            tr
              td.text-center(colspan='7') No depositors registered yet
    
    // Transaction History Table
    .section-title
      i.bi.bi-clock-history
      |  Recent Transactions
    .custom-table
      table
        thead
          tr
            th Date
            th Depositor
            th Type
            th Amount
            th Balance After
            th Processed By
        tbody
          if transactions && transactions.length
            each transaction in transactions
              tr
                td #{new Date(transaction.date).toLocaleDateString()}
                td #{transaction.depositorName}
                td
                  if transaction.type === 'Deposit'
                    span.badge(style='background:#2E7D64; color:white; padding:3px 8px; border-radius:30px;') Deposit
                  else
                    span.badge(style='background:#C6A43F; color:#0D3B2E; padding:3px 8px; border-radius:30px;') Withdrawal
                td UGX #{transaction.amount.toLocaleString()}
                td UGX #{transaction.balanceAfter.toLocaleString()}
                td #{transaction.processedBy}
          else
            tr
              td.text-center(colspan='6') No transactions recorded yet

  .footer
    i.bi.bi-shield-check
    |  NyondoStock &mdash; Enterprise Hardware Management System

  script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js')