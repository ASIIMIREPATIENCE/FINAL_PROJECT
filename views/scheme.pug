doctype html
html(lang='en')
head
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1.0')
  title NyondoStock - Deposit Scheme Management
  // Bootstrap 5 CSS + Icons
  link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css' rel='stylesheet')
  link(rel='stylesheet' href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css')
  link(rel='stylesheet' href='/css/scheme.css')

body
  // ========== SIDEBAR ==========
  .sidebar
    .sidebar-logo
      img(src='/images/logo.png' alt='Logo')
      h3 NyondoStock
      p Hardware Management

    .sidebar-user
      .user-name
        | 👤 #{user ? user.fullname : (currentUser ? currentUser.fullname : 'Guest User')}
        span.role-badge #{user ? (user.role === 'admin' ? 'Admin' : (user.role === 'store_manager' ? 'Manager' : 'Staff')) : (currentUser ? (currentUser.role === 'admin' ? 'Admin' : (currentUser.role === 'store_manager' ? 'Manager' : 'Staff')) : 'Guest')}
      .user-role #{user ? (user.role === 'admin' ? 'System Administrator' : (user.role === 'store_manager' ? 'Store Manager' : 'Sales Attendant')) : (currentUser ? (currentUser.role === 'admin' ? 'System Administrator' : (currentUser.role === 'store_manager' ? 'Store Manager' : 'Sales Attendant')) : 'Guest User')}
      button.logout-btn(onclick="window.location.href='/logout'")
        i.bi.bi-box-arrow-right
        |  Sign Out

  // ========== MAIN CONTENT ==========
  .main-content
    .d-flex.justify-content-between.align-items-center.flex-wrap.mb-3
      div
        h3(style='color: var(--nyondo-green); font-weight: 700; margin: 0;') Deposit Scheme Management
        p(style='color: #6c757d; margin: 5px 0 0 0; font-size: 0.8rem;') Manage customer deposits and track savings balances.
    
    // Display Flash Messages
    if messages && messages.success
      .alert.alert-success.alert-dismissible.fade.show(role='alert')
        i.bi.bi-check-circle-fill.me-2
        | #{messages.success}
        button.btn-close(type='button' data-bs-dismiss='alert')
    if messages && messages.error
      .alert.alert-danger.alert-dismissible.fade.show(role='alert')
        i.bi.bi-exclamation-triangle-fill.me-2
        | #{messages.error}
        button.btn-close(type='button' data-bs-dismiss='alert')
    
    // Summary Cards
    .row.g-3.mb-4
      .col-md-4
        .summary-card
          div(style='font-size: 0.7rem; opacity: 0.8;') Top Depositor
          if topBalanceDepositor
            .summary-value #{topBalanceDepositor.fullName}
            small(style='opacity: 0.7;') 
              | Balance: UGX #{topBalanceDepositor.currentBalance.toLocaleString()}
          else
            .summary-value(style='font-size: 1.2rem;') No deposits yet
            small(style='opacity: 0.7;') Waiting for first deposit
      .col-md-4
        .summary-card(style='background: linear-gradient(135deg, #C6A43F 0%, #B8922E 100%);')
          div(style='font-size: 0.7rem; opacity: 0.8;') Active Depositors
          .summary-value(style='color: #0D3B2E;') #{depositorsCount}
          small(style='opacity: 0.8;') Registered members
      .col-md-4
        .summary-card(style='background: linear-gradient(135deg, #2E7D64 0%, #236854 100%);')
          div(style='font-size: 0.7rem; opacity: 0.8;') Total Savings Balance
          .summary-value UGX #{currentBalance ? currentBalance.toLocaleString() : '0'}
          small(style='opacity: 0.8;') All depositors combined
    
    // Register New Depositor Form
    form(action='/registerDepositor' method='post')
      .form-card
        .form-title
          i.bi.bi-person-plus(style='color: #C6A43F;')
          |  Register New Depositor
          span.role-badge(style='background: #0D3B2E; color: white;') #{user ? (user.role === 'admin' ? 'Admin' : (user.role === 'store_manager' ? 'Manager' : 'Staff')) : (currentUser ? (currentUser.role === 'admin' ? 'Admin' : (currentUser.role === 'store_manager' ? 'Manager' : 'Staff')) : 'Staff')} Only
        .row.g-3
          .col-md-3
            label.form-label Full Name
            input.form-control(type='text' name='fullName' placeholder='Enter full name' required)
          .col-md-2
            label.form-label Phone Number
            input.form-control(type='tel' name='phoneNumber' placeholder='+256XXXXXXXXX' required)
          .col-md-2
            label.form-label NIN
            input.form-control(type='text' name='nin' placeholder='Enter NIN' required)
          .col-md-3
            label.form-label Employer (Optional)
            input.form-control(type='text' name='employer' placeholder='Company name')
          .col-md-2.d-flex.align-items-end
            button.btn-save.w-100(type='submit')
              i.bi.bi-save
              |  Register
    
    // Record Deposit Form (No date field - captured automatically)
    form(action='/recordDeposit' method='post')
      .form-card
        .form-title
          i.bi.bi-cash(style='color: #C6A43F;')
          |  Record New Deposit
          span.role-badge(style='background: #0D3B2E; color: white;') #{user ? (user.role === 'admin' ? 'Admin' : (user.role === 'store_manager' ? 'Manager' : 'Staff')) : (currentUser ? (currentUser.role === 'admin' ? 'Admin' : (currentUser.role === 'store_manager' ? 'Manager' : 'Staff')) : 'Staff')} Only
        .row.g-3
          .col-md-5
            label.form-label Select Depositor
            select.form-select(name='depositorId' required)
              option(value='') Select depositor...
              each depositor in depositors
                option(value=depositor._id) #{depositor.fullName} - Current Balance: UGX #{depositor.currentBalance.toLocaleString()}
          .col-md-3
            label.form-label Deposit Amount (UGX)
            input.form-control(type='number' name='amount' placeholder='Amount' required min='1000' step='1000')
          .col-md-2
            label.form-label Payment Method
            select.form-select(name='paymentMethod')
              option(value='Cash') Cash
              option(value='Bank Transfer') Bank Transfer
              option(value='Mobile Money') Mobile Money
          .col-md-2.d-flex.align-items-end
            button.btn-save.w-100(type='submit')
              i.bi.bi-check-circle
              |  Record Deposit
    
    // Depositors Table
    .section-title
      i.bi.bi-people
      |  Registered Depositors
    .custom-table
      table
        thead
          tr
            th Name
            th Phone
            th NIN
            th Employer
            th Date Joined
            th Current Balance
        tbody
          if depositors && depositors.length
            each depositor in depositors
              tr
                td #{depositor.fullName}
                td #{depositor.phoneNumber}
                td #{depositor.nin}
                td #{depositor.employer || 'N/A'}
                td #{depositor.joinDate ? new Date(depositor.joinDate).toLocaleDateString() : 'N/A'}
                td.balance-positive UGX #{depositor.currentBalance.toLocaleString()}
          else
            tr
              td.text-center(colspan='6') No depositors registered yet
    
    // Deposit History Table
    .section-title
      i.bi.bi-clock-history
      |  Recent Deposit History
    .custom-table
      table
        thead
          tr
            th Date
            th Depositor
            th Amount
            th Balance After
            th Payment Method
            th Attendant
        tbody
          if transactions && transactions.length
            each transaction in transactions
              tr
                td #{transaction.date ? new Date(transaction.date).toLocaleDateString() : 'N/A'}
                td #{transaction.depositorName}
                td.balance-positive UGX #{transaction.amount.toLocaleString()}
                td UGX #{transaction.balanceAfter.toLocaleString()}
                td #{transaction.paymentMethod || 'Cash'}
                td 
                  if transaction.attendantName
                    | #{transaction.attendantName}
                  else
                    span.text-muted Unknown User
          else
            tr
              td.text-center(colspan='6') No deposits recorded yet

  .footer
    i.bi.bi-shield-check
    |  NyondoStock &mdash; Enterprise Hardware Management System

  script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js')