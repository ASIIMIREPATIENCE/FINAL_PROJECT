doctype html
head
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1.0')
  title NyondoStock - Sales Recording
  // Bootstrap 5 CSS + Icons
  link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css' rel='stylesheet')
  link(rel='stylesheet' href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css')
  link(rel='stylesheet' href='/css/new_sale.css')
  
.sidebar
  .sidebar-logo
    img(src='/images/logo.png' alt='Logo')
    h3 NyondoStock
    p Hardware Management
  ul.nav-menu
    li.nav-item
      a.nav-link-custom(href='#')
        i.bi.bi-speedometer2
        |  Dashboard
    li.nav-item
      a.nav-link-custom(href='#')
        i.bi.bi-box-seam
        |  Stock Management
    li.nav-item
      a.nav-link-custom.active(href='#')
        i.bi.bi-cart-plus
        |  Sales Recording
    li.nav-item
      a.nav-link-custom(href='#')
        i.bi.bi-clock-history
        |  Sales History
    li.nav-item
      a.nav-link-custom(href='#')
        i.bi.bi-credit-card
        |  Supplier Credit
    li.nav-item
      a.nav-link-custom(href='#')
        i.bi.bi-piggy-bank
        |  Deposit Scheme
    li.nav-item
      a.nav-link-custom(href='#')
        i.bi.bi-bar-chart-steps
        |  Reports
    li.nav-item
      a.nav-link-custom(href='#')
        i.bi.bi-people
        |  User Management
  .sidebar-user
    .user-name
      | 👤 Admin User 
      span.role-badge Admin
    .user-role System Administrator
    button.logout-btn
      i.bi.bi-box-arrow-right
      |  Sign Out
      
.main-content
  // Top Bar
  .d-flex.justify-content-between.align-items-center.flex-wrap.mb-3
    div
      h3(style='color: var(--nyondo-green); font-weight: 700; margin: 0;') Sales Recording
      p(style='color: #6c757d; margin: 5px 0 0 0; font-size: 0.8rem;')
        | Record customer sales — add items to cart, calculate transport, complete transaction.
  
  // MAIN FORM
  form(action='/postSale' method='POST')
    // Customer Information Form
    .form-card
      .form-title
        i.bi.bi-person(style='color: #C6A43F;')
        |  Customer Information
      .row.g-3
        .col-md-4
          label.form-label Customer Name
          input.form-control(type='text' placeholder='Enter customer name' name='customername')
        .col-md-3
          label.form-label Phone Number
          input.form-control(type='tel' placeholder='07XX XXX XXX' name='phonenumber')
        .col-md-3
          label.form-label NIN (Optional)
          input.form-control(type='text' placeholder='National ID number' name='nin')
        .col-md-2
          label.form-label Payment Method
          select.form-select(name='paymentmethod')
            option Cash
            option Mobile Money
            option Credit
    
    // Add Product to Cart
    .form-card
      .row.g-3
        .col-md-4
          label.form-label Product Name
          input.form-control(type='text' placeholder='Search or select product' name='productname')
        .col-md-3
          label.form-label Quantity
          input.form-control(type='number' placeholder='Qty' name='quantity')
        .col-md-3
          label.form-label Unit Price (UGX)
          input.form-control(type='text' placeholder='0' name='unitprice')
    
    // Transport Calculation
    .form-card
      .row.g-3.mt-2
        .col-md-4
          .form-check
            input.form-check-input(type='checkbox' id='addTransport')
            label.form-check-label(style='font-size: 0.85rem;' for='addTransport')
              | Add Transport Charges
        .col-md-3
          label.form-label Distance (km)
          input.form-control(type='number' placeholder='Enter distance' name='distance')
        .col-md-3
          label.form-label Rate per km (UGX)
          input.form-control(type='number' name='rate')
    
    // Total & Complete Sale
    .form-card
      .row
        .col-md-6.offset-md-6
          .cart-table
            table(style='width: 100%;')
              tr
                td(style='padding: 8px;')
                  strong Subtotal:
                td(style='padding: 8px; text-align: right;') 
              tr
                td(style='padding: 8px;')
                  strong Transport:
                td(style='padding: 8px; text-align: right;') 
              tr.total-row
                td(style='padding: 8px;')
                  strong TOTAL:
                td(style='padding: 8px; text-align: right; font-size: 1.2rem; color: var(--nyondo-gold);') 
          button.btn-success-custom.mt-3(style='width: 100%;' type='submit')
            i.bi.bi-check-circle
            |  COMPLETE SALE

.footer
  i.bi.bi-shield-check
  |  NyondoStock — Enterprise Hardware Management System

script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js')