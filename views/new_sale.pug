doctype html
html(lang='en')
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    title NyondoStock - Sales Recording
    link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css' rel='stylesheet')
    link(rel='stylesheet' href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css')
    link(rel='stylesheet' href='/css/new_sale.css')
  
  body
    .sidebar
      .sidebar-logo
        img(src='/images/logo.png' alt='Logo')
        h3 NyondoStock
        p Hardware Management
      
      .sidebar-back-btn
        button.btn-back(onclick="history.back()")
          i.bi.bi-arrow-left
          | Back
      
      .sidebar-user
        .user-name 👤 #{currentUser ? currentUser.fullname : 'Admin User'}
        .user-role #{currentUser ? (currentUser.role === 'admin' ? 'Administrator' : (currentUser.role === 'store_manager' ? 'Store Manager' : 'Sales Attendant')) : 'System Administrator'}
        button.logout-btn(onclick="window.location.href='/logout'")
          i.bi.bi-box-arrow-right
          | Sign Out

    .main-content
      .d-flex.justify-content-between.align-items-center.flex-wrap.mb-3
        div
          h3(style='color: var(--nyondo-green); font-weight: 700; margin: 0;') Sales Recording
          p(style='color: #6c757d; margin: 5px 0 0 0; font-size: 0.8rem;')
            | Add items to cart — complete multiple products in one transaction
      
      // Alert messages container
      #alertContainer
        if success === true
          .alert.alert-success.alert-dismissible.fade.show(role='alert')
            i.bi.bi-check-circle-fill.me-2
            strong Sale completed successfully!
            button.btn-close(type='button' data-bs-dismiss='alert')
        
        if error
          .alert.alert-danger.alert-dismissible.fade.show(role='alert')
            i.bi.bi-exclamation-triangle-fill.me-2
            strong Error: #{error}
            button.btn-close(type='button' data-bs-dismiss='alert')
      
      .alert.alert-info.mb-3(role='alert')
        i.bi.bi-truck.me-2
        strong Transport Policy: 
        | Free delivery for purchases of UGX 500,000 or more within 10km radius. Otherwise, a fixed fee of UGX 30,000 applies.
      
      form#saleForm(action='/postSale' method='POST' novalidate)
        .form-card
          .form-title
            i.bi.bi-person(style='color: #C6A43F;')
            | Customer Information
          
          .row.g-3
            .col-md-4
              label.form-label Customer Name
              input#customerName.form-control(type='text' placeholder='Enter customer name' name='customername')
              .invalid-feedback Customer name is required
            
            
            .col-md-3
              label.form-label Phone Number
              input#customerPhone.form-control(type='tel' value='+256' name='phonenumber')
              .invalid-feedback Please enter a valid Ugandan phone number (+256XXXXXXXXX or 0XXXXXXXXX)
          
            
            .col-md-3
              label.form-label NIN (Optional)
              input#customerNin.form-control(type='text' placeholder='National ID number' name='nin')
              .invalid-feedback NIN must be in format CFXXXXXXXXXXXX or CMXXXXXXXXXXXX
       
            
            .col-md-2
              label.form-label Payment Method
              select#paymentMethod.form-select(name='paymentmethod')
                option(value='') Select payment method
                option(value='Cash') Cash
                option(value='Mobile Money') Mobile Money
                option(value='Bank Transfer') Bank Transfer
              .invalid-feedback Please select a payment method

        
        .form-card
          .form-title
            i.bi.bi-truck(style='color: #C6A43F;')
            | Transport Information
          
          .row.g-3
            .col-md-4
              .form-check
                input#addTransport.form-check-input(type='checkbox' name='addTransport' value='true')
                label.form-check-label Need Transport Delivery?
            .col-md-3
              label.form-label Distance (km)
              input#distance.form-control(type='number' name='distance' value='0' min='0' step='0.1')
              .invalid-feedback Please enter a valid distance in kilometers
            
        
        
        .form-card
          .form-title
            i.bi.bi-plus-circle(style='color: #C6A43F;')
            | Add Product to Cart
          
          .row.g-3
            .col-md-4
              label.form-label Product Name
              select#productName.form-select
                option(value='' disabled selected) Select Product
                each product in items 
                  option(value=product.productname data-price=product.sellingprice data-stock=product.quantity)= `${product.productname} (Stock: ${product.quantity} | Price: ${product.sellingprice} UGX)`
              .invalid-feedback Please select a product
              
            
            .col-md-3
              label.form-label Quantity
              input#quantity.form-control(type='number' value='1' min='1')
              .invalid-feedback Quantity must be at least 1
           
            
            .col-md-3
              label.form-label Unit Price (UGX)
              input#unitPrice.form-control(type='number' step='0.01')
              .invalid-feedback Valid unit price is required
             
            
            .col-md-2
              label.form-label &nbsp;
              button#addToCart.btn.btn-warning(type='button' style='background:#C6A43F; color:white; width:100%')
                i.bi.bi-cart-plus
                | Add to Cart
        
        .form-card
          .form-title
            i.bi.bi-cart(style='color: #C6A43F;')
            | Shopping Cart
          
          .table-responsive
            table.table
              thead
                tr
                  th Product
                  th Quantity
                  th Unit Price (UGX)
                  th Subtotal (UGX)
                  th
              tbody#cartBody
                tr
                  td(colspan='5' class='text-center text-muted') Cart is empty
          #cartErrorContainer
            // Cart error messages will appear here
        
        .form-card
          .form-title
            i.bi.bi-calculator(style='color: #C6A43F;')
            | Sale Summary
          .row
            .col-md-6.offset-md-6
              table.table.table-borderless
                tr
                  td Subtotal:
                  td.text-end UGX <span id="displaySubtotal">0</span>
                tr
                  td Transport Fee:
                  td.text-end UGX <span id="displayTransport">0</span>
                tr(style='border-top: 2px solid #dee2e6;')
                  td 
                    strong GRAND TOTAL:
                  td.text-end
                    strong UGX <span id="displayTotal">0</span>
        
        input#cartItems(type='hidden' name='cartItems')
        
        .form-card
          .row
            .col-md-12.d-flex.justify-content-center
              button#completeSale.btn-success-custom.mt-3(type='submit' style='width: 50%;')
                i.bi.bi-check-circle
                | COMPLETE SALE

    .footer
      i.bi.bi-shield-check
      | NyondoStock — Enterprise Hardware Management System

    script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js')
    
    script(src='/js/sale_cart.js')