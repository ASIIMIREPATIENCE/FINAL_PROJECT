doctype html
html(lang='en')
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    title NyondoStock - Edit Sale
    link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css' rel='stylesheet')
    link(rel='stylesheet' href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css')
    link(rel='stylesheet' href='/css/stock.css')
    style.
      .sidebar-back-btn { padding: 0 15px 15px 15px; border-bottom: 1px solid rgba(255,255,255,0.1); margin-bottom: 15px; }
      .btn-back { display: flex; align-items: center; gap: 10px; background: rgba(255,255,255,0.1); border: none; color: white; padding: 8px 12px; border-radius: 8px; width: 100%; cursor: pointer; }
      .btn-back:hover { background: rgba(255,255,255,0.2); }
      .cart-item { background: #f8f9fa; padding: 10px; margin-bottom: 10px; border-radius: 5px; border: 1px solid #dee2e6; }
      .btn-remove-item { background: #dc3545; color: white; border: none; padding: 5px 10px; border-radius: 4px; cursor: pointer; font-size: 0.7rem; }
      .btn-add-item { background: #C6A43F; color: #0D3B2E; border: none; padding: 8px 15px; border-radius: 4px; cursor: pointer; width: 100%; }
      .btn-add-item:hover { background: #b8922e; }

  body
    .sidebar
      .sidebar-logo
        img(src='/images/logo.png' alt='Logo')
        h3 NyondoStock
        p Hardware Management
      .sidebar-back-btn
        a.btn-back(href='/salesattendant' style='text-decoration: none; color: white;') 
          i.bi.bi-arrow-left
          | Back
      .sidebar-user
        .user-name 👤 #{currentUser ? currentUser.fullname : 'Admin User'}
        .user-role Sales Attendant
        button.logout-btn(onclick="window.location.href='/logout'") Sign Out

    .main-content(style='margin-left: 280px; padding: 2rem;')
      .container
        if error
          .alert.alert-danger #{error}
        
        .alert.alert-warning
          i.bi.bi-exclamation-triangle
          strong Warning: Editing this sale will restore original stock and deduct new quantities!
        
        .form-card
          .form-title
            i.bi.bi-pencil-square(style='color: #C6A43F;')
            | Edit Sale - #{sale._id.toString().slice(-8).toUpperCase()}
          
          form(id='editSaleForm' action=`/updateSale/${sale._id}` method='POST')
            .row.g-3
              .col-md-6
                label.form-label Customer Name
                input.form-control(type='text' name='customername' value=sale.customername required)
              .col-md-6
                label.form-label Phone Number
                input.form-control(type='tel' name='phonenumber' value=sale.phonenumber required)
              .col-md-4
                label.form-label NIN (Optional)
                input.form-control(type='text' name='nin' value=sale.nin)
              .col-md-4
                label.form-label Payment Method
                select.form-select(name='paymentmethod')
                  option(value='Cash' selected=(sale.paymentmethod === 'Cash')) Cash
                  option(value='Mobile Money' selected=(sale.paymentmethod === 'Mobile Money')) Mobile Money
                  option(value='Bank Transfer' selected=(sale.paymentmethod === 'Bank Transfer')) Bank Transfer
                  option(value='Deposit Scheme' selected=(sale.paymentmethod === 'Deposit Scheme')) Deposit Scheme
              .col-md-4
                .form-check.mt-4
                  input#addTransport.form-check-input(type='checkbox' name='addTransport' value='true' checked=sale.needTransport)
                  label.form-check-label Need Transport Delivery?
            
            .row.g-3.mt-2
              .col-md-6
                label.form-label Distance (km)
                input#distance.form-control(type='number' name='distance' value=sale.distance min='0')
              .col-md-6
                label.form-label Original Sale Date
                input.form-control(type='text' value=new Date(sale.Date).toLocaleString() disabled)
            
            hr.mt-4
            
            .form-title
              i.bi.bi-cart(style='color: #C6A43F;')
              | Cart Items
            
            .row.g-3.mb-3
              .col-md-5
                label.form-label Add Product
                select#productSelect.form-select
                  option(value='') Select Product
                  each product in items
                    option(value=product.productname data-price=product.sellingprice data-stock=product.quantity) #{product.productname} (Stock: #{product.quantity} | UGX #{product.sellingprice})
              .col-md-2
                label.form-label Quantity
                input#quantity.form-control(type='number' value='1' min='1')
              .col-md-3
                label.form-label Unit Price
                input#unitPrice.form-control(type='number' readonly style='background:#e9ecef')
              .col-md-2
                label.form-label &nbsp;
                button#addItem.btn-add-item(type='button')
                  i.bi.bi-cart-plus
                  | Add
            
            #cartContainer
              each item in sale.items
                .cart-item
                  .row.align-items-center
                    .col-md-5
                      strong #{item.productname}
                    .col-md-2 Qty: #{item.quantity}
                    .col-md-3 UGX #{item.unitprice.toLocaleString()}
                    .col-md-2
                      button.btn-remove-item(type='button' onclick='removeCartItem(this)') Remove
            
            input(type='hidden' name='cartItems' id='cartItemsInput')
            
            .mt-4
              button.btn-save(type='submit')
                i.bi.bi-save
                | Update Sale
              a.btn-delete(href='/salesattendant' style='margin-left: 10px; text-decoration: none;')
                i.bi.bi-x-circle
                | Cancel

    .footer(style='margin-left: 280px;')
      i.bi.bi-shield-check
      | NyondoStock

    script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js')
    script.
      let cart = [];
      
      // Load existing cart items from page
      function loadCart() {
        const items = document.querySelectorAll('#cartContainer .cart-item');
        items.forEach(item => {
          const productName = item.querySelector('strong').innerText;
          const qtyText = item.querySelector('.col-md-2').innerText;
          const priceText = item.querySelector('.col-md-3').innerText;
          const quantity = parseInt(qtyText.replace('Qty: ', ''));
          const price = parseFloat(priceText.replace('UGX ', '').replace(/,/g, ''));
          cart.push({ productName, quantity, unitPrice: price });
        });
        updateCartInput();
      }
      
      function updateCartInput() {
        document.getElementById('cartItemsInput').value = JSON.stringify(cart);
      }
      
      function renderCart() {
        const container = document.getElementById('cartContainer');
        container.innerHTML = '';
        
        if (cart.length === 0) {
          container.innerHTML = '<div class="alert alert-info">No items in cart</div>';
          updateCartInput();
          return;
        }
        
        cart.forEach((item, index) => {
          const div = document.createElement('div');
          div.className = 'cart-item';
          div.innerHTML = `
            <div class="row align-items-center">
              <div class="col-md-5"><strong>${escapeHtml(item.productName)}</strong></div>
              <div class="col-md-2">Qty: ${item.quantity}</div>
              <div class="col-md-3">UGX ${item.unitPrice.toLocaleString()}</div>
              <div class="col-md-2"><button type="button" class="btn-remove-item" onclick="removeCartItemByIndex(${index})">Remove</button></div>
            </div>
          `;
          container.appendChild(div);
        });
        updateCartInput();
      }
      
      function escapeHtml(str) {
        return str.replace(/[&<>]/g, function(m) {
          if (m === '&') return '&amp;';
          if (m === '<') return '&lt;';
          if (m === '>') return '&gt;';
          return m;
        });
      }
      
      window.removeCartItem = function(btn) {
        const itemDiv = btn.closest('.cart-item');
        const index = Array.from(itemDiv.parentElement.children).indexOf(itemDiv);
        cart.splice(index, 1);
        renderCart();
      }
      
      window.removeCartItemByIndex = function(index) {
        cart.splice(index, 1);
        renderCart();
      }
      
      // Add item to cart
      document.getElementById('addItem').addEventListener('click', function() {
        const select = document.getElementById('productSelect');
        const selected = select.options[select.selectedIndex];
        
        if (!selected.value) {
          alert('Please select a product');
          return;
        }
        
        const productName = selected.value;
        const unitPrice = parseFloat(document.getElementById('unitPrice').value);
        const quantity = parseInt(document.getElementById('quantity').value);
        const maxStock = parseInt(selected.getAttribute('data-stock'));
        
        if (isNaN(unitPrice) || unitPrice <= 0) {
          alert('Please select a valid product');
          return;
        }
        
        if (isNaN(quantity) || quantity <= 0) {
          alert('Please enter a valid quantity');
          return;
        }
        
        if (quantity > maxStock) {
          alert('Only ' + maxStock + ' items available');
          return;
        }
        
        const existing = cart.findIndex(i => i.productName === productName);
        if (existing !== -1) {
          cart[existing].quantity += quantity;
        } else {
          cart.push({ productName, quantity, unitPrice });
        }
        
        renderCart();
        select.value = '';
        document.getElementById('quantity').value = '1';
        document.getElementById('unitPrice').value = '';
      });
      
      // Update unit price on product select
      document.getElementById('productSelect').addEventListener('change', function() {
        const selected = this.options[this.selectedIndex];
        const price = selected.getAttribute('data-price');
        if (price) {
          document.getElementById('unitPrice').value = price;
        }
      });
      
      // Initialize
      loadCart();