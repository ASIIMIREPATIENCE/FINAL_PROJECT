doctype html
head
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1.0')
  title NyondoStock - Edit Stock Item
  link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css' rel='stylesheet')
  link(rel='stylesheet' href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css')
  link(rel='stylesheet' href='/css/stock.css')

.main-content(style='margin-left: 0; padding: 2rem;')
  .container
    .form-card
      .form-title
        i.bi.bi-pencil-square(style='color: #C6A43F;')
        |  Edit Stock Item
        span.role-badge(style='background: #0D3B2E; color: white;') #{item.productname} - #{item.category}
      
      form(action=`/editStock/${item._id}` method='post')
        .row.g-3
          .col-md-6
            label.form-label Product Name (Cannot be edited)
            input.form-control(type='text' value=item.productname disabled)
          
          .col-md-6
            label.form-label Category (Cannot be edited)
            input.form-control(type='text' value=item.category disabled)
          
          .col-md-3
            label.form-label Quantity
            input.form-control(type='number' name='quantity' value=item.quantity required)
          
          .col-md-3
            label.form-label Reorder Level
            input.form-control(type='number' name='reorderlevel' value=item.reorderlevel required)
          
          .col-md-3
            label.form-label Cost Price (UGX)
            input.form-control(type='number' name='costprice' value=item.costprice required)
          
          .col-md-3
            label.form-label Selling Price (UGX)
            input.form-control(type='number' name='sellingprice' value=item.sellingprice required)
          
          .col-md-6
            label.form-label Supplier
            input.form-control(type='text' name='supplier' value=item.supplier required)
          
          .col-md-6
            label.form-label Attendant (Cannot be edited)
            input.form-control(type='text' value=item.attendant || 'unknown attendant' disabled)
        
        .mt-4.d-flex.gap-2
          button.btn-save(type='submit')
            i.bi.bi-save
            |  Update Stock
          a.btn-delete(href='/addStock' style='text-decoration: none; display: inline-block; text-align: center; line-height: 38px;')
            i.bi.bi-x-circle
            |  Cancel

.footer
  i.bi.bi-shield-check
  |  NyondoStock &mdash; Enterprise Hardware Management System

script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js')