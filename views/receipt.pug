doctype html
html(lang='en')
head
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1.0')
  title NyondoStock - Sales Receipt
  link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css' rel='stylesheet')
  link(rel='stylesheet' href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css')
  link(rel='stylesheet' href='/css/receipt.css')

body

  .receipt-container
    .receipt-card
      // Receipt Header
      .receipt-header
        i.bi.bi-receipt(style='font-size: 2rem;')
        h2 SALES RECEIPT
        small #{new Date().toLocaleString()}
      
      // Receipt Body
      .receipt-body
        .company-info
          img(src='/images/logo.png' alt='Logo' style='height: 50px; margin-bottom: 10px;')
          h4 NyondoStock Hardware
          p(style='margin: 0; font-size: 0.8rem;') Tel: +256 7012345678
          p(style='margin: 0; font-size: 0.8rem;') Nansana, Kampala, Uganda
        
        .receipt-line
        
        // Customer Details
        .receipt-details
          .detail-row
            span <strong>Receipt No:</strong>
            span #SALE-#{sale._id.toString().slice(-8)}
          .detail-row
            span <strong>Date:</strong>
            span #{sale.Date ? new Date(sale.Date).toLocaleString() : new Date().toLocaleString()}
          .detail-row
            span <strong>Customer:</strong>
            span #{sale.customername || 'Walk-in Customer'}
          .detail-row
            span <strong>Phone:</strong>
            span #{sale.phonenumber || 'N/A'}
          .detail-row
            span <strong>Payment Method:</strong>
            span.status-paid #{sale.paymentmethod || 'Cash'}
          .detail-row
            span <strong>Attendant:</strong>
            span #{sale.attendantName || 'N/A'}
        
        .receipt-line
        
        // Items Purchased
        .receipt-details
          .row.mb-2(style='font-weight: bold; border-bottom: 1px solid #dee2e6; padding-bottom: 8px;')
            .col-5 Item
            .col-2.text-center Qty
            .col-2.text-end Price
            .col-3.text-end Total
          
          // Check if using new schema with items array
          if sale.items && sale.items.length
            each item in sale.items
              .row.mb-2
                .col-5 #{item.productname}
                .col-2.text-center #{item.quantity}
                .col-2.text-end UGX #{item.unitprice.toLocaleString()}
                .col-3.text-end UGX #{item.subtotal.toLocaleString()}
          else
            // Fallback for old schema (single product)
            if sale.productname
              .row.mb-2
                .col-5 #{sale.productname}
                .col-2.text-center #{sale.quantity}
                .col-2.text-end UGX #{sale.unitprice.toLocaleString()}
                .col-3.text-end UGX #{sale.subtotal.toLocaleString()}
            else
              .row.mb-2
                .col-12.text-center No items found
        
        .receipt-line
        
        // Totals
        .receipt-details
          .detail-row
            span <strong>Subtotal (Items):</strong>
            span UGX #{(sale.cartSubtotal || cartSubtotal || 0).toLocaleString()}
          
          if sale.transportFee && sale.transportFee > 0
            .detail-row
              span <strong>Transport Fee:</strong>
              span UGX #{sale.transportFee.toLocaleString()}
          else if transportFee && transportFee > 0
            .detail-row
              span <strong>Transport Fee:</strong>
              span UGX #{transportFee.toLocaleString()}
          else
            .detail-row
              span <strong>Transport Fee:</strong>
              span UGX 0
          
          .total-row
            span <strong>TOTAL:</strong>
            strong UGX #{(sale.grandTotal || grandTotal || 0).toLocaleString()}
        
        .receipt-line
        
        // Thank You Message
        .text-center
          p(style='margin: 0; font-size: 0.8rem;') Thank you for shopping with us!
          p(style='margin: 0; font-size: 0.7rem; color: #6c757d;') We value your business.
          p(style='margin: 0; font-size: 0.7rem; color: #6c757d;') Goods sold are not returnable. Please keep this receipt for any inquiries.  
      
      // Receipt Footer
      .receipt-footer.no-print
        button.btn-print(type='button' onclick='window.print()')
          i.bi.bi-printer.me-2
          | Print Receipt
        a.btn-back(href='/salesattendant')
          i.bi.bi-arrow-left.me-2
          | New Sale

  script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js')