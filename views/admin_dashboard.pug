doctype html
head
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1.0')
  title NyondoStock - Admin Dashboard
  // Bootstrap 5 CSS + Icons
  link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css' rel='stylesheet')
  link(rel='stylesheet' href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css')
  link(rel='stylesheet' href='/css/admin_dashboard.css')
// ========== SIDEBAR WITH DROPDOWNS - ADMIN FULL ACCESS ==========
.sidebar
  .sidebar-logo
    img(src='/images/logo.png' alt='Logo')
    h3 NyondoStock
    p Enterprise Management
  ul.nav-menu
    // Dashboard - Direct Link
    li.nav-item
      a.nav-link-custom.active(href='#')
        i.bi.bi-speedometer2
        |  Dashboard
    // Stock Management Dropdown
    li.nav-item
      button.dropdown-btn(onclick="toggleDropdown('stockDropdown')")
        span.dropdown-title
          i.bi.bi-box-seam
          |  Stock Management
        i.bi.bi-chevron-down
      #stockDropdown.dropdown-container
        a.dropdown-item(href='#')
          i.bi.bi-plus-circle
          |  Add New Stock
        a.dropdown-item(href='#')
          i.bi.bi-list-ul
          |  View All Stock
        a.dropdown-item(href='#')
          i.bi.bi-exclamation-triangle
          |  Low Stock Alerts
        a.dropdown-item(href='#')
          i.bi.bi-arrow-repeat
          |  Stock Adjustments
        a.dropdown-item(href='#')
          i.bi.bi-upc-scan
          |  Stock Categories
    // Sales Management Dropdown
    li.nav-item
      button.dropdown-btn(onclick="toggleDropdown('salesDropdown')")
        span.dropdown-title
          i.bi.bi-cart-plus
          |  Sales Management
        i.bi.bi-chevron-down
      #salesDropdown.dropdown-container
        a.dropdown-item(href='#')
          i.bi.bi-receipt
          |  New Sale
        a.dropdown-item(href='#')
          i.bi.bi-clock-history
          |  Sales History
        a.dropdown-item(href='#')
          i.bi.bi-printer
          |  Print Receipt
        a.dropdown-item(href='#')
          i.bi.bi-truck
          |  Transport Charges
    // Supplier Credit Dropdown
    li.nav-item
      button.dropdown-btn(onclick="toggleDropdown('creditDropdown')")
        span.dropdown-title
          i.bi.bi-credit-card
          |  Supplier Credit
        i.bi.bi-chevron-down
      #creditDropdown.dropdown-container
        a.dropdown-item(href='#')
          i.bi.bi-plus-circle
          |  Record Credit
        a.dropdown-item(href='#')
          i.bi.bi-cash-stack
          |  Record Payment
        a.dropdown-item(href='#')
          i.bi.bi-list-ul
          |  Credit Summary
        a.dropdown-item(href='#')
          i.bi.bi-calendar
          |  Payment Schedule
    // Deposit Scheme Dropdown
    li.nav-item
      button.dropdown-btn(onclick="toggleDropdown('depositDropdown')")
        span.dropdown-title
          i.bi.bi-piggy-bank
          |  Deposit Scheme
        i.bi.bi-chevron-down
      #depositDropdown.dropdown-container
        a.dropdown-item(href='#')
          i.bi.bi-person-plus
          |  Register Depositor
        a.dropdown-item(href='#')
          i.bi.bi-cash
          |  Record Deposit
        a.dropdown-item(href='#')
          i.bi.bi-cash-stack
          |  Record Withdrawal
        a.dropdown-item(href='#')
          i.bi.bi-list-ul
          |  Depositors List
        a.dropdown-item(href='#')
          i.bi.bi-bar-chart
          |  Deposit Reports
    // Reports Dropdown
    li.nav-item
      button.dropdown-btn(onclick="toggleDropdown('reportsDropdown')")
        span.dropdown-title
          i.bi.bi-bar-chart-steps
          |  Reports
        i.bi.bi-chevron-down
      #reportsDropdown.dropdown-container
        a.dropdown-item(href='#')
          i.bi.bi-graph-up
          |  Sales Report
        a.dropdown-item(href='#')
          i.bi.bi-box-seam
          |  Stock Report
        a.dropdown-item(href='#')
          i.bi.bi-credit-card
          |  Credit Report
        a.dropdown-item(href='#')
          i.bi.bi-piggy-bank
          |  Deposit Report
        a.dropdown-item(href='#')
          i.bi.bi-calculator
          |  Profit Report
    // User Management Dropdown
    li.nav-item
      button.dropdown-btn(onclick="toggleDropdown('userDropdown')")
        span.dropdown-title
          i.bi.bi-people
          |  User Management
        i.bi.bi-chevron-down
      #userDropdown.dropdown-container
        a.dropdown-item(href='#')
          i.bi.bi-person-plus
          |  Add New User
        a.dropdown-item(href='#')
          i.bi.bi-list-ul
          |  View All Users
        a.dropdown-item(href='#')
          i.bi.bi-person-badge
          |  Manage Roles
  .sidebar-user
    .user-name 👤 Admin User
    .user-role System Administrator
  // Logout button - aligned at bottom
  .logout-wrapper
    a(href="/")
      button.logout-btn(type="button")
        i.bi.bi-box-arrow-right
        |  Sign Out
// ========== MAIN CONTENT ==========
.main-content
  .d-flex.justify-content-between.align-items-center.flex-wrap.mb-3
    div
      h3(style='color: var(--nyondo-green); font-weight: 700; margin: 0;') Dashboard
      p(style='color: #6c757d; margin: 5px 0 0 0; font-size: 0.8rem;') Welcome back, Admin &mdash; full system overview.
    .d-flex.gap-2.mt-2.mt-md-0
      .search-bar
        i.bi.bi-search.me-2
        input(type='text' placeholder='Search...')
      button.export-btn
        i.bi.bi-file-earmark-excel
        |  Export
  // Stats Row - 6 Cards
  .row.g-3.mb-4
    .col-md-2.col-sm-4.col-6
      .stat-card
        .stat-value UGX 48.2M
        .stat-label Stock Value
    .col-md-2.col-sm-4.col-6
      .stat-card
        .stat-value UGX 1.85M
        .stat-label Today's Sales
    .col-md-2.col-sm-4.col-6
      .stat-card
        .stat-value UGX 6.63M
        .stat-label Outstanding Credit
    .col-md-2.col-sm-4.col-6
      .stat-card
        .stat-value UGX 4.2M
        .stat-label Total Deposits
    .col-md-2.col-sm-4.col-6
      .stat-card
        .stat-value 4
        .stat-label Low Stock
    .col-md-2.col-sm-4.col-6
      .profit-card
        .stat-label(style='color: rgba(255,255,255,0.7);') Today's Profit
        .profit-value UGX 730K
        small(style='color: rgba(255,255,255,0.5);') Margin: 39%
  // Row 1: Low Stock + Supplier Credit
  .row.g-3
    .col-lg-7
      .section-title
        i.bi.bi-exclamation-triangle-fill(style='color: #C6A43F;')
        |  Low Stock Alerts
      .custom-table
        table
          thead
            tr
              th Product
              th Current Stock
              th Reorder Level
              th Status
          tbody
            tr
              td Portland Cement (50kg)
              td 28 bags
              td 50 bags
              td
                span.badge-critical Critical
            tr
              td 3-inch Nails (box)
              td 12 boxes
              td 20 boxes
              td
                span.badge-low Low
            tr
              td PVC Pipe 4" (10ft)
              td 8 pieces
              td 15 pieces
              td
                span.badge-low Low
            tr
              td Paint Brush 4"
              td 15 pcs
              td 25 pcs
              td
                span.badge-low Low
    .col-lg-5
      .section-title
        i.bi.bi-credit-card
        |  Supplier Credit Summary
      .custom-table
        table
          thead
            tr
              th Supplier
              th Amount Owed
              th Due Date
              th Status
          tbody
            tr
              td Bamburi Cement Ltd
              td UGX 2.45M
              td May 30
              td
                span.badge-pending Pending
            tr
              td Rainbow Paints
              td UGX 980K
              td Jun 10
              td
                span.badge-paid On Track
            tr
              td Steel Masters Ltd
              td UGX 3.2M
              td May 25
              td
                span.badge-overdue Overdue
  // Row 2: Recent Sales + Deposit Scheme
  .row.g-3.mt-2
    .col-lg-7
      .section-title
        i.bi.bi-clock-history
        |  Recent Sales
      .custom-table
        table
          thead
            tr
              th Time
              th Customer
              th Items
              th Total
              th Status
          tbody
            tr
              td 10:30 AM
              td Sarah Kamau
              td Cement (10 bags)
              td UGX 350K
              td
                span.badge-paid Paid
            tr
              td 11:15 AM
              td John Otieno
              td Paint (5 cans)
              td UGX 275K
              td
                span.badge-paid Paid
            tr
              td 1:45 PM
              td Peter Omondi
              td Pipes &amp; Fittings
              td UGX 189.5K
              td
                span.badge-pending Credit
            tr
              td 3:20 PM
              td Alice Wanjiku
              td Nails (8 boxes)
              td UGX 64K
              td
                span.badge-paid Paid
    .col-lg-5
      .section-title
        i.bi.bi-piggy-bank
        |  Deposit Scheme Summary
      .custom-table
        table
          thead
            tr
              th Depositor
              th Total Deposits
              th Withdrawals
              th Balance
          tbody
            tr
              td James Mwangi
              td UGX 1.2M
              td UGX 200K
              td UGX 1.0M
            tr
              td Mary Wanjiku
              td UGX 850K
              td UGX 150K
              td UGX 700K
            tr
              td Peter Ochieng
              td UGX 2.1M
              td UGX 500K
              td UGX 1.6M
            tr
              td Lucy Achieng
              td UGX 450K
              td UGX 0
              td UGX 450K
.footer
  i.bi.bi-shield-check
  |  NyondoStock &mdash; Enterprise Hardware Management System
script.
  function toggleDropdown(id) {
  var dropdown = document.getElementById(id);
  dropdown.classList.toggle('show');
  }
script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js')