doctype html
html(lang='en')
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    title NyondoStock - Admin Dashboard
    link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css' rel='stylesheet')
    link(rel='stylesheet' href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css')
    link(rel='stylesheet' href='/css/admin_dashboard.css')

  body
    .sidebar
      .sidebar-logo
        img(src='/images/logo.png' alt='Logo')
        h3 NyondoStock
        p Enterprise Management
      ul.nav-menu
        li.nav-item
          a.nav-link-custom.active(href='#')
            i.bi.bi-speedometer2
            |  Dashboard
        li.nav-item
          button.dropdown-btn(onclick="toggleDropdown('stockDropdown')")
            span.dropdown-title
              i.bi.bi-box-seam
              |  Stock Management
            i.bi.bi-chevron-down
          #stockDropdown.dropdown-container
            a.dropdown-item(href='#') Add New Stock
            a.dropdown-item(href='#') View All Stock
        li.nav-item
          button.dropdown-btn(onclick="toggleDropdown('salesDropdown')")
            span.dropdown-title
              i.bi.bi-cart-plus
              |  Sales Management
            i.bi.bi-chevron-down
          #salesDropdown.dropdown-container
            a.dropdown-item(href='/sale') New Sale
            a.dropdown-item(href='#') Sales History
        li.nav-item
          button.dropdown-btn(onclick="toggleDropdown('creditDropdown')")
            span.dropdown-title
              i.bi.bi-credit-card
              |  Supplier Credit
            i.bi.bi-chevron-down
          #creditDropdown.dropdown-container
            a.dropdown-item(href='#') Record Credit
            a.dropdown-item(href='#') Record Payment
        li.nav-item
          button.dropdown-btn(onclick="toggleDropdown('depositDropdown')")
            span.dropdown-title
              i.bi.bi-piggy-bank
              |  Deposit Scheme
            i.bi.bi-chevron-down
          #depositDropdown.dropdown-container
            a.dropdown-item(href='#') Register Depositor
            a.dropdown-item(href='#') Record Deposit
        li.nav-item
          button.dropdown-btn(onclick="toggleDropdown('reportsDropdown')")
            span.dropdown-title
              i.bi.bi-bar-chart-steps
              |  Reports
            i.bi.bi-chevron-down
          #reportsDropdown.dropdown-container
            a.dropdown-item(href='#') Sales Report
            a.dropdown-item(href='#') Stock Report
        li.nav-item
          button.dropdown-btn(onclick="toggleDropdown('userDropdown')")
            span.dropdown-title
              i.bi.bi-people
              |  User Management
            i.bi.bi-chevron-down
          #userDropdown.dropdown-container
            a.dropdown-item(href='#') Add New User
            a.dropdown-item(href='#') View All Users
      .sidebar-user
        .user-name 👤 Admin User
        .user-role System Administrator
      .logout-wrapper
        a(href="/")
          button.logout-btn(type="button")
            i.bi.bi-box-arrow-right
            |  Sign Out

    .main-content
      .d-flex.justify-content-between.align-items-center.flex-wrap.mb-3
        div
          h3(style='color: var(--nyondo-green); font-weight: 700; margin: 0;') Dashboard
          p(style='color: #6c757d; margin: 5px 0 0 0; font-size: 0.8rem;') Welcome back, Admin
      
      .row.g-3.mb-4
        .col-md-3.col-sm-4.col-6
          .stat-card
            .stat-value UGX #{totalStockValue}
            .stat-label Stock Value
        .col-md-3.col-sm-4.col-6
          .stat-card
            .stat-value UGX #{todaysSalesTotal}
            .stat-label Today's Sales
        .col-md-3.col-sm-4.col-6
          .stat-card
            .stat-value UGX #{outstandingCredit}
            .stat-label Supplier Credit
        .col-md-3.col-sm-4.col-6
          .stat-card
            .stat-value UGX #{totalDeposits}
            .stat-label Total Deposits
      
      .row.g-3
        .col-lg-7
          .section-title
            i.bi.bi-box-seam
            |  Stock Inventory
          .table-responsive.custom-table.mb-4
            table.table.mb-0
              thead
                tr
                  th Date
                  th Product Name
                  th Current Stock
                  th Reorder Level
                  th Selling Price
              tbody
                if stockItems && stockItems.length
                  each item in stockItems
                    tr
                      td #{item.Date ? item.Date.toLocaleDateString() : 'No date'}
                      td #{item.productname || 'Unknown'}
                      td #{item.quantity || 0}
                      td #{item.reorderlevel || 'N/A'}
                      td #{item.sellingprice ? 'UGX ' + item.sellingprice : 'N/A'}
                else
                  tr
                    td.text-center(colspan='5') No stock items found
        
        .col-lg-5
          .section-title
            i.bi.bi-credit-card
            |  Supplier Credit Summary
          .custom-table
            table
              thead
                tr
                  th Supplier
                  th Amount Owed
                  th Due Date
                  th Status
              tbody
                if creditStockItems && creditStockItems.length
                  each item in creditStockItems
                    if item.balance > 0
                      tr
                        td #{item.supplier || 'Unknown'}
                        td UGX #{item.balance ? item.balance.toLocaleString() : '0'}
                        td #{item.dueDate ? item.dueDate.toLocaleDateString() : 'Not set'}
                        td
                          if item.status === 'Overdue'
                            span.badge-overdue Overdue
                          else
                            span.badge-pending Pending
                else
                  tr
                    td.text-center(colspan='4') No credit records found

      .row.g-3.mt-2
        .col-lg-7
          .section-title
            i.bi.bi-clock-history
            |  Recent Sales
          .custom-table
            table.table.mb-0
              thead
                tr
                  th Date
                  th Customer Name
                  th Products
                  th Total
                  th Attendant
              tbody
                if allSales && allSales.length
                  each sale in allSales.slice(0, 10)
                    tr
                      td #{sale.Date ? sale.Date.toLocaleDateString() : 'No date'}
                      td #{sale.customername || 'Walk-in Customer'}
                      td #{sale.products ? sale.products.join(', ') : 'Unknown'}
                      td UGX #{sale.grandTotal ? sale.grandTotal.toLocaleString() : '0'}
                      td #{sale.attendantName || 'unknown'}
                else
                  tr
                    td.text-center(colspan='5') No sales found
        
        .col-lg-5
          .section-title
            i.bi.bi-piggy-bank
            |  Deposit Scheme Summary
          .custom-table
            table
              thead
                tr
                  th Depositor
                  th Latest Deposit
                  th Balance
              tbody
                if depositors && depositors.length
                  each depositor in depositors
                    - let latestDeposit = 0
                    if depositor.depositHistory && depositor.depositHistory.length
                      - latestDeposit = depositor.depositHistory[depositor.depositHistory.length - 1].amount
                    tr
                      td #{depositor.fullName || 'Unknown'}
                      td UGX #{latestDeposit || 0}
                      td UGX #{depositor.currentBalance || 0}
                else
                  tr
                    td.text-center(colspan='3') No depositors found

    .footer
      i.bi.bi-shield-check
      |  NyondoStock &mdash; Enterprise Hardware Management System

    script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js')
