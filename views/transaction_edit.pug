doctype html
html(lang='en')
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    title NyondoStock - Edit Transaction
    link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css' rel='stylesheet')
    link(rel='stylesheet' href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css')
    link(rel='stylesheet' href='/css/stock.css')
    style.
      .sidebar-back-btn {
        padding: 0 15px 15px 15px;
        border-bottom: 1px solid rgba(255,255,255,0.1);
        margin-bottom: 15px;
      }
      .btn-back {
        display: flex;
        align-items: center;
        gap: 10px;
        background: rgba(255,255,255,0.1);
        border: none;
        color: white;
        padding: 8px 12px;
        border-radius: 8px;
        width: 100%;
        cursor: pointer;
        transition: all 0.2s ease;
      }
      .btn-back:hover {
        background: rgba(255,255,255,0.2);
      }
  body
    .sidebar
      .sidebar-logo
        img(src='/images/logo.png' alt='Logo')
        h3 NyondoStock
        p Hardware Management
      
      .sidebar-back-btn
        button.btn-back(onclick="history.back()")
          i.bi.bi-arrow-left
          | Back
      
      .sidebar-user
        .user-name 👤 #{currentUser ? currentUser.fullname : 'Admin User'}
        .user-role #{currentUser ? (currentUser.role === 'admin' ? 'System Administrator' : (currentUser.role === 'store_manager' ? 'Store Manager' : 'Sales Attendant')) : 'System Administrator'}
        button.logout-btn(onclick="window.location.href='/logout'")
          i.bi.bi-box-arrow-right
          | Sign Out

    .main-content(style='margin-left: 280px; padding: 2rem;')
      .container
        .form-card
          .form-title
            i.bi.bi-pencil-square(style='color: #C6A43F;')
            | Edit Transaction
            span.role-badge(style='background: #0D3B2E; color: white; margin-left: 10px;') #{transaction.productname} - #{transaction.transactionType}
          
          form(action=`/editTransaction/${transaction._id}` method='POST')
            .row.g-3
              .col-md-6
                label.form-label Product Name (Cannot be edited)
                input.form-control(type='text' value=transaction.productname disabled)
              
              .col-md-6
                label.form-label Transaction Type (Cannot be edited)
                input.form-control(type='text' value=transaction.transactionType disabled)
              
              .col-md-4
                label.form-label Previous Quantity (Cannot be edited)
                input.form-control(type='number' id='previousQuantity' value=transaction.previousQuantity disabled)
              
              .col-md-4
                label.form-label Added Quantity (Edit this)
                input.form-control(type='number' name='addedQuantity' id='addedQuantity' value=transaction.addedQuantity required oninput='calculateNewQuantity()')
              
              .col-md-4
                label.form-label New Quantity (Auto-calculated)
                input.form-control(type='number' name='quantity' id='newQuantity' value=transaction.newQuantity readonly style='background-color: #e9ecef;')
              
              .col-md-4
                label.form-label Cost Price (UGX)
                input.form-control(type='number' name='costprice' value=transaction.costprice required)
              
              .col-md-4
                label.form-label Selling Price (UGX)
                input.form-control(type='number' name='sellingprice' value=transaction.sellingprice required)
              
              .col-md-4
                label.form-label Reorder Level
                input.form-control(type='number' name='reorderlevel' value=transaction.reorderlevel)
              
              .col-md-6
                label.form-label Supplier Name
                input.form-control(type='text' name='supplier' value=transaction.supplier required)
              
              .col-md-6
                label.form-label Supplier Email
                input.form-control(type='email' name='supplierEmail' value=transaction.supplierEmail)
              
              .col-md-6
                label.form-label Supplier Phone
                input.form-control(type='tel' name='supplierPhone' value=transaction.supplierPhone)
              
              .col-md-6
                label.form-label Supplier Company
                input.form-control(type='text' name='supplierCompany' value=transaction.supplierCompany)
              
              .col-md-6
                label.form-label Payment Method
                select.form-control(name='paymentMethod')
                  option(value='Cash' selected=(transaction.paymentMethod === 'Cash')) Cash
                  option(value='Credit' selected=(transaction.paymentMethod === 'Credit')) Credit (Supplier Credit)
              
              .col-md-12
                label.form-label Notes
                textarea.form-control(name='notes' rows='3') #{transaction.notes}
              
              .col-md-12
                .alert.alert-warning
                  i.bi.bi-exclamation-triangle
                  strong Warning: 
                  | Editing this transaction will update your current stock levels!
            
            .mt-4.d-flex.gap-2
              button.btn-save(type='submit')
                i.bi.bi-save
                | Update Transaction
              a.btn-delete(href='/addStock' style='text-decoration: none; display: inline-block; text-align: center; line-height: 38px;')
                i.bi.bi-x-circle
                | Cancel

    .footer(style='margin-left: 280px;')
      i.bi.bi-shield-check
      | NyondoStock &mdash; Enterprise Hardware Management System

    script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js')
    script.
      function calculateNewQuantity() {
        const previousQty = parseFloat(document.getElementById('previousQuantity').value) || 0;
        const addedQty = parseFloat(document.getElementById('addedQuantity').value) || 0;
        const newQty = previousQty + addedQty;
        document.getElementById('newQuantity').value = newQty;
      }