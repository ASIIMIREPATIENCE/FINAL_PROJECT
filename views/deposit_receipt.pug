doctype html
html(lang='en')
head
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1.0')
  title NyondoStock - Deposit Receipt
  // Bootstrap 5 CSS + Icons
  link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css' rel='stylesheet')
  link(rel='stylesheet' href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css')
  link(rel='stylesheet' href='/css/deposit_receipt.css')

body

  .receipt-container
    .receipt-card
      // Receipt Header
      .receipt-header
        i.bi.bi-piggy-bank(style='font-size: 2rem;')
        h2 DEPOSIT RECEIPT
        small #{new Date().toLocaleString()}
      
      // Receipt Body
      .receipt-body
        .company-info
          img(src='/images/logo.png' alt='Logo' style='height: 50px; margin-bottom: 10px;')
          h4 NyondoStock Hardware
          p(style='margin: 0; font-size: 0.8rem;') Tel: +256 7012345678
          p(style='margin: 0; font-size: 0.8rem;') Nansana, Kampala, Uganda
        
        .receipt-line
        
        // Deposit Details
        .receipt-details
          .detail-row
            span <strong>Date:</strong>
            span #{deposit.date ? new Date(deposit.date).toLocaleString() : new Date().toLocaleString()}
          .detail-row
            span <strong>Depositor Name:</strong>
            span #{depositor.fullName}
          .detail-row
            span <strong>Phone Number:</strong>
            span #{depositor.phoneNumber}
          .detail-row
            span <strong>Payment Method:</strong>
            span #{deposit.paymentMethod || 'Cash'}
          .detail-row
            span <strong>Attendant:</strong>
            span #{deposit.attendantName || 'System Admin'}
        
        .receipt-line
        
        // Deposit Amount
        .deposit-amount
          | UGX #{deposit.amount.toLocaleString()}
        
        .receipt-line
        
        // Balance Information
        .receipt-details
          .detail-row
            span <strong>Previous Balance:</strong>
            span UGX #{(deposit.balanceAfter - deposit.amount).toLocaleString()}
          .total-row
            span <strong>New Balance:</strong>
            span <strong>UGX #{deposit.balanceAfter.toLocaleString()}</strong>
        
        .receipt-line
        
        // Thank You Message
        .text-center
          p(style='margin: 0; font-size: 0.8rem;') Thank you for saving with us!
          p(style='margin: 0; font-size: 0.7rem; color: #6c757d;') Keep saving to reach your goals.
          p(style='margin: 0; font-size: 0.7rem; color: #6c757d;') This is your official deposit receipt.
      
      // Receipt Footer
      .receipt-footer.no-print
        button.btn-print(onclick='window.print()')
          i.bi.bi-printer.me-2
          | Print Receipt
        a.btn-back(href='/scheme')
          i.bi.bi-arrow-left.me-2
          | Back to Scheme

  // Bootstrap JS Bundle
  script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js')