doctype html
html(lang='en')
head
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1.0')
  title NyondoStock - Deposit Receipt
  link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css' rel='stylesheet')
  link(rel='stylesheet' href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css')
  link(rel='stylesheet' href='/css/deposit_receipt.css')
  style.
    @media print {
      .no-print { display: none; }
      .receipt-container { margin: 0; padding: 0; }
    }
    .deposit-amount {
      font-size: 2rem;
      font-weight: 700;
      color: #2E7D64;
      margin: 1rem 0;
    }
    .total-row {
      border-top: 2px solid #dee2e6;
      padding-top: 8px;
      margin-top: 8px;
      font-weight: bold;
      font-size: 1.1rem;
    }
    .transport-free {
      color: #28a745;
      font-weight: bold;
    }
    .transport-charge {
      color: #dc3545;
      font-weight: bold;
    }

body
  .receipt-container
    .receipt-card
      .receipt-body
        .company-info
          img(src='/images/logo.png' alt='Logo' style='height: 50px; margin-bottom: 10px;')
          h4 NyondoStock Hardware
          p(style='margin: 0; font-size: 0.8rem;') Tel: +256 7012345678
          p(style='margin: 0; font-size: 0.8rem;') Nansana, Kampala, Uganda
        
        .receipt-line
        
        // Deposit Details
        .receipt-details
          .detail-row
            span <strong>Receipt No:</strong>
            span #DEP-#{deposit._id ? deposit._id.toString().slice(-8) : Math.floor(Math.random() * 1000000)}
          .detail-row
            span <strong>Date:</strong>
            span #{deposit.date ? new Date(deposit.date).toLocaleString() : new Date().toLocaleString()}
          .detail-row
            span <strong>Depositor Name:</strong>
            span #{depositor.fullName}
          .detail-row
            span <strong>Phone Number:</strong>
            span #{depositor.phoneNumber}
          .detail-row
            span <strong>Payment Method:</strong>
            span #{deposit.paymentMethod || 'Cash'}
          .detail-row
            span <strong>Attendant:</strong>
            span #{deposit.attendantName || 'System Admin'}
        
        .receipt-line
        
        // Items Being Saved For
        if depositor.items && depositor.items.length
          .section-title(style='font-weight: 700; margin-bottom: 8px;') Items Being Saved For:
          .items-list
            each item in depositor.items
              .detail-row
                span #{item.productname} (x#{item.quantity})
                span UGX #{item.subtotal.toLocaleString()}
          .receipt-line
        
        // BILL CALCULATION
        .section-title(style='font-weight: 700; margin-bottom: 8px;') Bill Summary:
        .receipt-details
          .detail-row
            span Items Subtotal:
            span UGX #{depositor.itemsSubtotal.toLocaleString()}
          .detail-row
            span Transport:
            if depositor.transportFee === 0
              span.transport-free UGX 0 
            else
              span.transport-charge UGX 30,000
          .detail-row(style='border-top: 2px solid #dee2e6; margin-top: 5px; padding-top: 5px;')
            span <strong>TOTAL AMOUNT OWED:</strong>
            span <strong>UGX #{(depositor.itemsSubtotal + depositor.transportFee).toLocaleString()}</strong>
        
        .receipt-line
        
        // Payment Details
        .section-title(style='font-weight: 700; margin-bottom: 8px;') Payment Summary:
        .receipt-details
          .detail-row
            span Total Amount Owed:
            span UGX #{(depositor.itemsSubtotal + depositor.transportFee).toLocaleString()}
          .detail-row
            span Amount Paid Before:
            span UGX #{(depositor.totalPaid - deposit.amountPaid).toLocaleString()}
          .detail-row(style='border-top: 1px dashed #dee2e6; margin-top: 5px; padding-top: 5px;')
            span <strong>Amount Paid Now:</strong>
            span <strong>UGX #{deposit.amountPaid.toLocaleString()}</strong>
        
        .receipt-line
        
        // Balance After Payment
        .receipt-details
          .detail-row
            span Total Paid So Far:
            span UGX #{depositor.totalPaid.toLocaleString()}
          .total-row
            span <strong>Remaining Balance:</strong>
            span <strong>UGX #{((depositor.itemsSubtotal + depositor.transportFee) - depositor.totalPaid).toLocaleString()}</strong>
        
        .receipt-line
        
        // Thank You Message
        .text-center
          p(style='margin: 0; font-size: 0.8rem;') Thank you for saving with us!
          p(style='margin: 0; font-size: 0.7rem; color: #6c757d;') Keep saving to reach your goals.
          p(style='margin: 0; font-size: 0.7rem; color: #6c757d;') This is your official deposit receipt.
      
      .receipt-footer.no-print
        button.btn-print(onclick='window.print()')
          i.bi.bi-printer.me-2
          | Print Receipt
        a.btn-back(href='/scheme')
          i.bi.bi-arrow-left.me-2
          | Back to Scheme

  script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js')
