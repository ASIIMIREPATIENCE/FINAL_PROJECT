doctype html
html(lang='en')
head
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1.0')
  title NyondoStock - Stock Management
  link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css' rel='stylesheet')
  link(rel='stylesheet' href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css')
  link(rel='stylesheet' href='/css/stock.css')


body
  .sidebar
    .sidebar-logo
      img(src='/images/logo.png' alt='Logo')
      h3 NyondoStock
      p Hardware Management
    
    .sidebar-back-btn
      button.btn-back(onclick="history.back()")
        i.bi.bi-arrow-left
        | Back
    
    .sidebar-user
      .user-name 👤 #{currentUser ? currentUser.fullname : 'Admin User'}
      .user-role #{currentUser ? (currentUser.role === 'admin' ? 'System Administrator' : (currentUser.role === 'store_manager' ? 'Store Manager' : 'Sales Attendant')) : 'System Administrator'}
      button.logout-btn(onclick="window.location.href='/logout'")
        i.bi.bi-box-arrow-right
        | Sign Out

  .main-content
    .d-flex.justify-content-between.align-items-center.flex-wrap.mb-3
      div
        h3(style='color: var(--nyondo-green); font-weight: 700; margin: 0;') Stock Management
        p(style='color: #6c757d; margin: 5px 0 0 0; font-size: 0.8rem;') Manage your inventory &mdash; add, edit, or view stock levels.

    // Alert container for notifications
    #alertContainer

    // Add New Stock Form
    form#stockForm(action='/postStock' method='post' novalidate)
      .form-card
        .form-title
          i.bi.bi-plus-circle(style='color: #C6A43F;')
          | Register New Stock
          span.role-badge Admin/Manager Only
        .row.g-3
          .col-md-3
            label.form-label Product Name
            input#productName.form-control(type='text' placeholder='Enter product name' name='productname')
            .invalid-feedback Product name is required
          .col-md-2
            label.form-label Category
            select#category.form-select(name='category')
              option(value='') Select category
              option Cement
              option Iron Bars
              option wheel Barrows
              option Wire Mesh
              option Nails
              option Barbed Wire
              option Iron Sheets
            .invalid-feedback Please select a category

          .col-md-2
            label.form-label Quantity
            input#quantity.form-control(type='number' placeholder='0' name='quantity')
            .invalid-feedback Quantity must be at least 1
          .col-md-2
            label.form-label Cost Price (UGX)
            input#costPrice.form-control(type='number' placeholder='Cost price' name='costprice')
            .invalid-feedback Cost price must be greater than 0

          .col-md-2
            label.form-label Selling Price (UGX)
            input#sellingPrice.form-control(type='number' placeholder='Selling price' name='sellingprice')
            .invalid-feedback Selling price must be greater than cost price

          .col-md-3
            label.form-label Supplier Name
            input#supplierName.form-control(type='text' placeholder='Supplier name' name='supplier')
            .invalid-feedback Supplier name is required

          .col-md-3
            label.form-label Supplier Email
            input#supplierEmail.form-control(type='email' placeholder='supplier@company.com' name='supplierEmail')
            .invalid-feedback Enter a valid email address

          .col-md-2
            label.form-label Supplier Phone
            input#supplierPhone.form-control(type='tel' value='+256' name='supplierPhone')
            .invalid-feedback Use +256XXXXXXXXX or 0XXXXXXXXX

          .col-md-3
            label.form-label Supplier Company
            input#supplierCompany.form-control(type='text' placeholder='Company name' name='supplierCompany')
            .invalid-feedback Supplier company is required

          .col-md-2
            label.form-label Reorder Level
            input#reorderLevel.form-control(type='number' placeholder='Min stock alert' name='reorderlevel')
            .invalid-feedback Reorder level must be at least 1

          .col-md-2
            label.form-label Payment Method
            select#paymentMethod.form-select(name='paymentMethod')
              option(value='') Select payment method
              option(value='Cash') Cash
              option(value='Credit') Credit (Supplier Credit)
            .invalid-feedback Please select payment method

          .col-md-2.d-flex.align-items-end
            button.btn-save.w-100(type='submit')
              i.bi.bi-save
              | Save Stock

    // SECTION 1: Current Stock Table
    .section-title.mt-4
      i.bi.bi-list-ul
      | Current Stock Inventory
      - var lowCount = 0
      - var criticalCount = 0
      each item in stockItems
        if item.quantity <= item.reorderlevel / 2
          - criticalCount++
        else if item.quantity <= item.reorderlevel
          - lowCount++
      if lowCount > 0
        span.badge-low.ms-2 #{lowCount} Low Stock Items
      if criticalCount > 0
        span.badge-critical.ms-2 #{criticalCount} Critical Items

    .custom-table
      table
        thead
          tr
            th Product Name
            th Category
            th Current Stock
            th Selling Price

        tbody
          if stockItems && stockItems.length
            each item in stockItems
              - var isLowStock = item.quantity <= item.reorderlevel
              - var isCriticalStock = item.quantity <= (item.reorderlevel / 2)
              - var rowClass = ''
              - var stockNumberClass = 'stock-number-normal'
              
              if isCriticalStock
                - rowClass = 'critical-stock-row'
                - stockNumberClass = 'stock-number-critical'
              else if isLowStock
                - rowClass = 'low-stock-row'
                - stockNumberClass = 'stock-number-low'
              
              tr(class=rowClass)
                td 
                  strong #{item.productname || 'Unknown product'}
                  if isCriticalStock
                    span.badge-critical.ms-2 CRITICAL!
                  else if isLowStock
                    span.badge-low.ms-2 LOW STOCK!
                td #{item.category || 'N/A'}
                td
                  span(class=stockNumberClass) #{item.quantity || 0}
                  if isCriticalStock
                    i.bi.bi-exclamation-triangle.warning-icon(style='color: #9E3C2A; margin-left: 5px;')
                  else if isLowStock
                    i.bi.bi-exclamation-circle.warning-icon(style='color: #C6A43F; margin-left: 5px;')
                td #{item.sellingprice ? 'UGX ' + item.sellingprice.toLocaleString() : 'N/A'}

          else
            tr
              td.text-center(colspan='5') No stock items found

    // SECTION 2: Supplier Information Table
    .section-title.mt-4
      i.bi.bi-truck
      | Supplier Information
    .custom-table
      table
        thead
          tr
            th Supplier Name
            th Contact Email
            th Contact Phone
            th Product Supplied
            th Supplier Company
            th Payment Method
        tbody
          if stockItems && stockItems.length
            each item in stockItems
              tr
                td #{item.supplier || 'N/A'}
                td #{item.supplierEmail || 'N/A'}
                td #{item.supplierPhone || 'N/A'}
                td #{item.productname || 'N/A'}
                td #{item.supplierCompany || 'N/A'}
                td 
                  if item.paymentMethod
                    | #{item.paymentMethod}
                  else
                    | Cash
          else
            tr
              td.text-center(colspan='6') No supplier information found

    // SECTION 3: Stock Transaction History Table
    .section-title.mt-4
      i.bi.bi-clock-history
      | Stock Entries
      span.role-badge(style='background: #C6A43F; color: #0D3B2E; margin-left: 10px;') Edit/Delete Affects Stock
    .custom-table
      table
        thead
          tr
            th Date & Time
            th Product Name
            th Transaction Type
            th Previous Qty
            th Added Qty
            th New Qty
            th Cost Price
            th Selling Price
            th Supplier
            th Attendant
            th Actions
        tbody
          if stockTransactions && stockTransactions.length
            each transaction in stockTransactions
              tr
                td #{transaction.Date ? new Date(transaction.Date).toLocaleString() : 'No date'}
                td 
                  strong #{transaction.productname || 'Unknown'}
                td
                  if transaction.transactionType === 'ADD_NEW'
                    span.badge(style='background: #28a745; color: white; padding: 3px 8px; border-radius: 20px; font-size: 0.7rem;')
                      i.bi.bi-plus-circle.me-1
                      | New Stock
                  else if transaction.transactionType === 'UPDATE_QUANTITY'
                    span.badge(style='background: #ffc107; color: black; padding: 3px 8px; border-radius: 20px; font-size: 0.7rem;')
                      i.bi.bi-arrow-repeat.me-1
                      | Quantity Update
                  else if transaction.transactionType === 'DELETE'
                    span.badge(style='background: #dc3545; color: white; padding: 3px 8px; border-radius: 20px; font-size: 0.7rem;')
                      i.bi.bi-trash.me-1
                      | Deleted
                td #{transaction.previousQuantity || 0}
                td 
                  if transaction.addedQuantity > 0
                    span(style='color: #28a745; font-weight: bold;') +#{transaction.addedQuantity}
                  else if transaction.addedQuantity < 0
                    span(style='color: #dc3545; font-weight: bold;') #{transaction.addedQuantity}
                  else
                    | 0
                td #{transaction.newQuantity || 0}
                td UGX #{transaction.costprice ? transaction.costprice.toLocaleString() : '0'}
                td UGX #{transaction.sellingprice ? transaction.sellingprice.toLocaleString() : '0'}
                td #{transaction.supplier || 'N/A'}
                td #{transaction.attendantName || 'unknown'}
                td
                  .action-buttons
                    if transaction.transactionType !== 'DELETE'
                      button.btn-edit-transaction(type='button' onclick=`editTransaction('${transaction._id}')`)
                        i.bi.bi-pencil
                        | Edit
                      button.btn-delete-transaction(type='button' onclick=`deleteTransaction('${transaction._id}')`)
                        i.bi.bi-trash
                        | Delete
          else
            tr
              td.text-center(colspan='11') No stock transaction records found

  .footer
    i.bi.bi-shield-check
    | NyondoStock &mdash; Enterprise Hardware Management System

  script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js')
  script(src='/js/stock.js?v=2')