doctype html
html(lang='en')
head
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1.0')
  title NyondoStock - Stock Management
  link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css' rel='stylesheet')
  link(rel='stylesheet' href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css')
  link(rel='stylesheet' href='/css/stock.css')
  style.
    .action-buttons {
      display: flex;
      gap: 8px;
      justify-content: center;
      align-items: center;
    }

body
  .sidebar
    .sidebar-logo
      img(src='/images/logo.png' alt='Logo')
      h3 NyondoStock
      p Hardware Management
    
    .sidebar-user
      .user-name 👤 #{currentUser ? currentUser.fullname : 'Admin User'}
      .user-role #{currentUser ? (currentUser.role === 'admin' ? 'System Administrator' : (currentUser.role === 'store_manager' ? 'Store Manager' : 'Sales Attendant')) : 'System Administrator'}
      button.logout-btn(onclick="window.location.href='/logout'")
        i.bi.bi-box-arrow-right
        |  Sign Out

  .main-content
    .d-flex.justify-content-between.align-items-center.flex-wrap.mb-3
      div
        h3(style='color: var(--nyondo-green); font-weight: 700; margin: 0;') Stock Management
        p(style='color: #6c757d; margin: 5px 0 0 0; font-size: 0.8rem;') Manage your inventory &mdash; add, edit, or view stock levels.

    // Add New Stock Form
    form(action='/postStock' method='post')
      .form-card
        .form-title
          i.bi.bi-plus-circle(style='color: #C6A43F;')
          |  Register New Stock
          span.role-badge Admin/Manager Only
        .row.g-3
          .col-md-3
            label.form-label Product Name
            input.form-control(type='text' placeholder='Enter product name' name='productname' required)
          .col-md-2
            label.form-label Category
            select.form-select(name='category' required)
              option Cement
              option Pipes
              option Paint
              option Tools
              option Nails
              option Electrical
          .col-md-2
            label.form-label Quantity
            input.form-control(type='number' placeholder='0' name='quantity' required)
          .col-md-2
            label.form-label Cost Price (UGX)
            input.form-control(type='number' placeholder='Cost price' name='costprice' required)
          .col-md-2
            label.form-label Selling Price (UGX)
            input.form-control(type='number' placeholder='Selling price' name='sellingprice' required)
          .col-md-3
            label.form-label Supplier
            input.form-control(type='text' placeholder='Supplier name' name='supplier' required)
          .col-md-2
            label.form-label Reorder Level
            input.form-control(type='number' placeholder='Min stock alert' name='reorderlevel' required)
          .col-md-2
            label.form-label Payment Method
            select.form-select(name='paymentMethod')
              option(value='Cash') Cash
              option(value='Credit') Credit (Supplier Credit)
          .col-md-2.d-flex.align-items-end
            button.btn-save.w-100(type='submit')
              i.bi.bi-save
              |  Save Stock

    // Current Stock Table
    .section-title
      i.bi.bi-list-ul
      |  Current Stock Inventory
      - var lowCount = 0
      - var criticalCount = 0
      each item in stockItems
        if item.quantity <= item.reorderlevel / 2
          - criticalCount++
        else if item.quantity <= item.reorderlevel
          - lowCount++
      if lowCount > 0
        span.badge-low.ms-2 #{lowCount} Low Stock Items
      if criticalCount > 0
        span.badge-critical.ms-2 #{criticalCount} Critical Items

    .custom-table
      table
        thead
          tr
            th Date
            th Product Name
            th Category
            th Current Stock
            th Reorder Level
            th Cost Price
            th Selling Price
            th Supplier
            th Payment Method
            th Attendant
            th(style='text-align: center; width: 140px;') Actions
        tbody
          if stockItems && stockItems.length
            each item in stockItems
              - var isLowStock = item.quantity <= item.reorderlevel
              - var isCriticalStock = item.quantity <= (item.reorderlevel / 2)
              - var rowClass = ''
              - var stockNumberClass = 'stock-number-normal'
              
              if isCriticalStock
                - rowClass = 'critical-stock-row'
                - stockNumberClass = 'stock-number-critical'
              else if isLowStock
                - rowClass = 'low-stock-row'
                - stockNumberClass = 'stock-number-low'
              
              tr(class=rowClass)
                td #{item.Date ? new Date(item.Date).toLocaleDateString() : 'No date'}
                td 
                  strong #{item.productname || 'Unknown product'}
                  if isCriticalStock
                    span.badge-critical.ms-2 CRITICAL!
                  else if isLowStock
                    span.badge-low.ms-2 LOW STOCK!
                td #{item.category || 'N/A'}
                td
                  span(class=stockNumberClass) #{item.quantity || 0}
                  if isCriticalStock
                    i.bi.bi-exclamation-triangle.warning-icon(style='color: #9E3C2A; margin-left: 5px;')
                  else if isLowStock
                    i.bi.bi-exclamation-circle.warning-icon(style='color: #C6A43F; margin-left: 5px;')
                td 
                  if item.reorderlevel
                    span #{item.reorderlevel}
                  else
                    | N/A
                td #{item.costprice ? 'UGX ' + item.costprice.toLocaleString() : 'N/A'}
                td #{item.sellingprice ? 'UGX ' + item.sellingprice.toLocaleString() : 'N/A'}
                td #{item.supplier || 'N/A'}
                td 
                  if item.paymentMethod
                    | #{item.paymentMethod}
                  else
                    | Cash
                td #{item.attendantName || (item.attendant ? item.attendant.fullname : 'unknown')}
                td(style='text-align: center;')
                  .action-buttons
                    a.btn-edit(href=`/editStock/${item._id}`)
                      i.bi.bi-pencil
                      | Edit
                    form(action=`/deleteStock/${item._id}` method='POST' style='display: inline; margin: 0;')
                      button.btn-delete(type='submit' onclick='return confirm("Are you sure you want to delete this item?")')
                        i.bi.bi-trash
                        | Delete
          else
            tr
              td.text-center(colspan='11') No stock items found

    // Stock Transaction History Table
    .section-title.mt-4
      i.bi.bi-clock-history
      |  Stock Transaction History
    .custom-table
      table
        thead
          tr
            th Date & Time
            th Product Name
            th Transaction Type
            th Previous Qty
            th Added Qty
            th New Qty
            th Cost Price
            th Selling Price
            th Supplier
            th Attendant
            th Notes
        tbody
          if stockTransactions && stockTransactions.length
            each transaction in stockTransactions
              tr
                td #{transaction.Date ? new Date(transaction.Date).toLocaleString() : 'No date'}
                td 
                  strong #{transaction.productname || 'Unknown'}
                td
                  if transaction.transactionType === 'ADD_NEW'
                    span.badge(style='background: #28a745; color: white; padding: 3px 8px; border-radius: 20px; font-size: 0.7rem;')
                      i.bi.bi-plus-circle.me-1
                      | New Stock
                  else if transaction.transactionType === 'UPDATE_QUANTITY'
                    span.badge(style='background: #ffc107; color: black; padding: 3px 8px; border-radius: 20px; font-size: 0.7rem;')
                      i.bi.bi-arrow-repeat.me-1
                      | Quantity Update
                  else if transaction.transactionType === 'DELETE'
                    span.badge(style='background: #dc3545; color: white; padding: 3px 8px; border-radius: 20px; font-size: 0.7rem;')
                      i.bi.bi-trash.me-1
                      | Deleted
                td #{transaction.previousQuantity || 0}
                td 
                  if transaction.addedQuantity > 0
                    span(style='color: #28a745; font-weight: bold;') +#{transaction.addedQuantity}
                  else if transaction.addedQuantity < 0
                    span(style='color: #dc3545; font-weight: bold;') #{transaction.addedQuantity}
                  else
                    | 0
                td #{transaction.newQuantity || 0}
                td UGX #{transaction.costprice ? transaction.costprice.toLocaleString() : '0'}
                td UGX #{transaction.sellingprice ? transaction.sellingprice.toLocaleString() : '0'}
                td #{transaction.supplier || 'N/A'}
                td #{transaction.attendantName || 'unknown'}
                td #{transaction.notes || '-'}
          else
            tr
              td.text-center(colspan='11') No stock transaction records found

  .footer
    i.bi.bi-shield-check
    |  NyondoStock &mdash; Enterprise Hardware Management System

  script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js')