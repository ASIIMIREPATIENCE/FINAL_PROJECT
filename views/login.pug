doctype html
html(lang='en')
head
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1.0')
  title NyondoStock - Login
  link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css' rel='stylesheet')
  link(rel='stylesheet' href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css')
  link(rel='stylesheet' href='/css/login.css')

body
  .login-card
    img(src='/images/logo.png' alt='NyondoStock Logo')
    h2 NyondoStock
    p Hardware Management System
    
    #alertContainer
      if message
        .alert.alert-danger(role='alert') #{message}
      if error
        .alert.alert-danger(role='alert') #{error}
    
    .security-badge
      i.bi.bi-shield-lock-fill
      span SECURE ACCESS
    
    form#loginForm(action='postlogin' method='post' novalidate)
      .mb-3.text-start
        label.form-label.fw-semibold(style='color: #0D3B2E;') Email
        input#email.form-control(type='email' placeholder='Enter your email' name='email')
        .invalid-feedback Please enter a valid email address
        
      
      .mb-3.text-start
        label.form-label.fw-semibold(style='color: #0D3B2E;') Password
        input#password.form-control(type='password' placeholder='Enter your password' name='password')
        .invalid-feedback Password is required
        
      
      button.btn-login(type='submit')
        i.bi.bi-box-arrow-in-right.me-2
        | LOG IN
    
    
  script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js')
  script(src='/js/login.js')