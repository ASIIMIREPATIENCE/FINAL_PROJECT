doctype html
html(lang='en')
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    title NyondoStock - Manager Dashboard
    link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css' rel='stylesheet')
    link(rel='stylesheet' href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css')
    link(rel='stylesheet' href='/css/admin_dashboard.css')

  body
    .sidebar
      .sidebar-logo
        img(src='/images/logo.png' alt='Logo')
        h3 NyondoStock
        p Enterprise Management
      ul.nav-menu
        li.nav-item
          a.nav-link-custom.active(href='/manager')
            i.bi.bi-speedometer2
            |  Dashboard
        li.nav-item
          a.nav-link-custom(href='/addStock')
            i.bi.bi-box-seam
            |  Stock Management
        li.nav-item
          a.nav-link-custom(href='/salesattendant')
            i.bi.bi-cart-plus
            |  Sales Management
      .sidebar-user
        .user-name 👤 #{currentUser ? currentUser.fullname : 'Store Manager'}
        .user-role Store Manager
      .logout-wrapper
        a(href="/logout")
          button.logout-btn(type="button")
            i.bi.bi-box-arrow-right
            |  Sign Out

    .main-content
      .d-flex.justify-content-between.align-items-center.flex-wrap.mb-3
        div
          h3(style='color: var(--nyondo-green); font-weight: 700; margin: 0;') Manager Dashboard
          p(style='color: #6c757d; margin: 5px 0 0 0; font-size: 0.8rem;') Welcome back, #{currentUser.fullname || 'Store Manager'}
      
      .row.g-3.mb-4
        .col-md-3.col-sm-4.col-6
          .stat-card
            .stat-value UGX #{totalStockValue}
            .stat-label Stock Value
        .col-md-3.col-sm-4.col-6
          .stat-card
            .stat-value UGX #{todaySales}
            .stat-label Today's Sales
        .col-md-3.col-sm-4.col-6
          .stat-card
            .stat-value #{creditSuppliersCount}
            .stat-label Suppliers with Credit
        .col-md-3.col-sm-4.col-6
          .stat-card
            .stat-value #{stockItems ? stockItems.length : 0}
            .stat-label Total Products
      
      .row.g-3
        .col-lg-7
          .section-title
            i.bi.bi-box-seam
            |  Stock Inventory
            - var lowCount = 0
            - var criticalCount = 0
            if stockItems && stockItems.length
              each item in stockItems
                if item.quantity <= item.reorderlevel / 2
                  - criticalCount++
                else if item.quantity <= item.reorderlevel
                  - lowCount++
            if lowCount > 0
              span.badge-low.ms-2 #{lowCount} Low Stock Items
            if criticalCount > 0
              span.badge-critical.ms-2 #{criticalCount} Critical Items
          .table-responsive.custom-table.mb-4
            table.table.mb-0
              thead
                tr
                  th Date
                  th Product Name
                  th Current Stock
                  th Reorder Level
                  th Selling Price
              tbody
                if stockItems && stockItems.length
                  each item in stockItems
                    - var isLowStock = item.quantity <= item.reorderlevel
                    - var isCriticalStock = item.quantity <= (item.reorderlevel / 2)
                    - var rowClass = ''
                    - var stockNumberClass = 'stock-number-normal'
                    
                    if isCriticalStock
                      - rowClass = 'critical-stock-row'
                      - stockNumberClass = 'stock-number-critical'
                    else if isLowStock
                      - rowClass = 'low-stock-row'
                      - stockNumberClass = 'stock-number-low'
                    
                    tr(class=rowClass)
                      td #{item.Date ? new Date(item.Date).toLocaleDateString() : 'No date'}
                      td 
                        strong #{item.productname || 'Unknown'}
                        if isCriticalStock
                          span.badge-critical.ms-2 CRITICAL!
                        else if isLowStock
                          span.badge-low.ms-2 LOW STOCK!
                      td
                        span(class=stockNumberClass) #{item.quantity || 0}
                        if isCriticalStock
                          i.bi.bi-exclamation-triangle.ms-1(style='color: #9E3C2A;')
                        else if isLowStock
                          i.bi.bi-exclamation-circle.ms-1(style='color: #C6A43F;')
                      td #{item.reorderlevel || 'N/A'}
                      td #{item.sellingprice ? 'UGX ' + item.sellingprice.toLocaleString() : 'N/A'}
                else
                  tr
                    td.text-center(colspan='5') No stock items found
        
        .col-lg-5
          .section-title
            i.bi.bi-credit-card
            |  Supplier Credit Summary
          .custom-table
            table
              thead
                tr
                  th Supplier
                  th Amount Owed
                  th Due Date
                  th Status
              tbody
                if creditStockItems && creditStockItems.length
                  each item in creditStockItems
                    if item.balance > 0
                      tr
                        td #{item.supplier || 'Unknown'}
                        td UGX #{item.balance ? item.balance.toLocaleString() : '0'}
                        td #{item.dueDate ? new Date(item.dueDate).toLocaleDateString() : 'Not set'}
                        td
                          if item.status === 'Overdue'
                            span.badge-overdue Overdue
                          else
                            span.badge-pending Pending
                else
                  tr
                    td.text-center(colspan='4') No credit records found

      .row.g-3.mt-4
        .col-lg-8
          .section-title
            i.bi.bi-clock-history
            |  Recent Sales
          .custom-table
            table
              thead
                tr
                  th Date
                  th Customer Name
                  th Products
                  th Total
                  th Payment Method
                  th Attendant
              tbody
                if allSales && allSales.length
                  each sale in allSales.slice(0, 10)
                    tr
                      td #{sale.Date ? new Date(sale.Date).toLocaleDateString() : 'No date'}
                      td #{sale.customername || 'Walk-in Customer'}
                      td 
                        if sale.items && sale.items.length
                          each item, index in sale.items.slice(0, 2)
                            | #{item.productname}
                            if index < sale.items.slice(0, 2).length - 1
                              | , 
                          if sale.items.length > 2
                            |  +#{sale.items.length - 2} more
                        else
                          | Unknown
                      td UGX #{sale.grandTotal ? sale.grandTotal.toLocaleString() : '0'}
                      td 
                        span.badge(style='background: #0D3B2E; color: white; padding: 3px 8px; border-radius: 30px;') #{sale.paymentmethod || 'Cash'}
                      td #{sale.attendantName || 'unknown'}
                else
                  tr
                    td.text-center(colspan='6') No sales found
        
        .col-lg-4
          .section-title
            i.bi.bi-trophy
            |  Top Selling Products
          .custom-table
            table
              thead
                tr
                  th Product Name
                  th Quantity Sold
              tbody
                if topProducts && topProducts.length
                  each product in topProducts
                    tr
                      td #{product._id || 'Unknown'}
                      td #{product.totalSold || 0}
                else
                  tr
                    td.text-center(colspan='2') No sales data available

    .footer
      i.bi.bi-shield-check
      |  NyondoStock &mdash; Enterprise Hardware Management System

    script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js')
