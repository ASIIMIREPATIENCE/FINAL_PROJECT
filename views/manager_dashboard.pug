doctype html
head
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1.0')
  title NyondoStock - Store Manager Dashboard
  // Bootstrap 5 CSS + Icons
  link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css' rel='stylesheet')
  link(rel='stylesheet' href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css')
  link(rel='stylesheet' href='/css/manager_dashboard.css')
// ========== SIDEBAR ==========
.sidebar
  .logo
    img(src='/images/logo.png' alt='Logo')
    h4 NyondoStock
    p Hardware Management
  nav.nav.flex-column
    a.nav-link.active(href='#')
      i.bi.bi-speedometer2
      |  Dashboard
    a.nav-link(href='#')
      i.bi.bi-box-seam
      |  Stock Management
    a.nav-link(href='#')
      i.bi.bi-cart-plus
      |  Sales Recording
    a.nav-link(href='#')
      i.bi.bi-clock-history
      |  Sales History
    a.nav-link(href='#')
      i.bi.bi-bar-chart-steps
      |  Reports
  .user-section
    .user-name &#x1F464; Michael Nyondo
    .user-role Store Manager
    button.logout-btn
      i.bi.bi-box-arrow-right
      |  Sign Out
// ========== MAIN CONTENT ==========
.main-content
  // Top Bar with Dashboard Title and Search
  .d-flex.justify-content-between.align-items-center.flex-wrap.mb-4
    div
      h3(style='color: var(--nyondo-green); font-weight: 700;') Dashboard
      p(style='color: #6c757d; margin: 0;') Welcome back, Michael &mdash; here&apos;s what&apos;s happening at Nyondo Hardware today.
    .search-bar.mt-2.mt-md-0
      i.bi.bi-search.me-2
      input(type='text' placeholder='Search products...')
  // Stats Row - 4 Cards
  .row.g-3.mb-4
    .col-md-3.col-sm-6
      .stat-card
        .stat-value UGX 48.2M
        .stat-label Total Stock Value
    .col-md-3.col-sm-6
      .stat-card
        .stat-value UGX 1.85M
        .stat-label Today&apos;s Sales
    .col-md-3.col-sm-6
      .stat-card
        .stat-value 4
        .stat-label Low Stock Alerts
    .col-md-3.col-sm-6
      .stat-card
        .stat-value 23
        .stat-label Active Depositors
  // Two Column Layout: Low Stock Table + Top Products
  .row.g-3
    // Left Column: Low Stock Alerts Table
    .col-lg-7
      .section-title
        i.bi.bi-exclamation-triangle-fill(style='color: #C6A43F;')
        |  Low Stock Alerts
      .table-responsive.custom-table
        table.table.mb-0
          thead
            tr
              th Product
              th Current Stock
              th Reorder Level
              th Status
              th Action
          tbody
            tr
              td Portland Cement (50kg)
              td 28 bags
              td 50 bags
              td
                span.badge-critical Critical
              td
                button.btn-reorder
                  i.bi.bi-cart-plus
                  |  Reorder
            tr
              td 3-inch Nails (box)
              td 12 boxes
              td 20 boxes
              td
                span.badge-low Low
              td
                button.btn-reorder
                  i.bi.bi-cart-plus
                  |  Reorder
            tr
              td PVC Pipe 4&quot; (10ft)
              td 8 pieces
              td 15 pieces
              td
                span.badge-low Low
              td
                button.btn-reorder
                  i.bi.bi-cart-plus
                  |  Reorder
            tr
              td Paint Brush 4&quot;
              td 15 pcs
              td 25 pcs
              td
                span.badge-low Low
              td
                button.btn-reorder
                  i.bi.bi-cart-plus
                  |  Reorder
    // Right Column: Top Selling Products
    .col-lg-5
      .section-title
        i.bi.bi-trophy-fill(style='color: #C6A43F;')
        |  Top Selling Products
      .top-product-list
        .top-product-item
          .d-flex.align-items-center.gap-3
            .product-rank 1
            .product-name Portland Cement
          .product-sales 1,450 bags
        .top-product-item
          .d-flex.align-items-center.gap-3
            .product-rank 2
            .product-name 3-inch Nails
          .product-sales 890 boxes
        .top-product-item
          .d-flex.align-items-center.gap-3
            .product-rank 3
            .product-name PVC Pipe 4&quot;
          .product-sales 456 pieces
        .top-product-item
          .d-flex.align-items-center.gap-3
            .product-rank 4
            .product-name Paint Brush 4&quot;
          .product-sales 342 pcs
        .top-product-item
          .d-flex.align-items-center.gap-3
            .product-rank 5
            .product-name White Paint (20L)
          .product-sales 278 cans
  // Recent Sales Table
  .section-title.mt-4
    i.bi.bi-clock-history
    |  Recent Sales
  .table-responsive.custom-table
    table.table.mb-0
      thead
        tr
          th Time
          th Customer
          th Items
          th Total
          th Status
      tbody
        tr
          td 10:30 AM
          td Sarah Kamau
          td Cement (10 bags)
          td UGX 350,000
          td
            span.badge-paid Paid
        tr
          td 11:15 AM
          td John Otieno
          td Paint (5 cans)
          td UGX 275,000
          td
            span.badge-paid Paid
        tr
          td 1:45 PM
          td Peter Omondi
          td Pipes &amp; Fittings
          td UGX 189,500
          td
            span.badge-low(style='background:#C6A43F;') Credit
        tr
          td 3:20 PM
          td Alice Wanjiku
          td Nails (8 boxes)
          td UGX 64,000
          td
            span.badge-paid Paid
// Footer
.footer
  i.bi.bi-shield-check
  |  NyondoStock &mdash; Enterprise Hardware Management System
script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js')
