doctype html
head
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1.0')
  title NyondoStock | Enterprise Hardware Management
  // Bootstrap 5 CSS + Icons + Font
  link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css' rel='stylesheet')
  link(rel='stylesheet' href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css')
  link(href='https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700;14..32,800&display=swap' rel='stylesheet')
  link(rel='stylesheet' href='/css/index.css')
// Navigation
nav.navbar.navbar-expand-lg
  .container
    a.navbar-brand(href='#')
      img(src='/images/logo.png' alt='NyondoStock Logo')
      .brand-text
        | NYONDO STORE
        br
        small Hardware Management
    button.navbar-toggler(type='button' data-bs-toggle='collapse' data-bs-target='#navbarNav')
      span.navbar-toggler-icon
// Hero Section
section.hero-section
  .container
    .hero-content
      // Security Badge
      .security-badge
        i.bi.bi-shield-lock-fill
        span ENTERPRISE SECURITY ENABLED
      // Main Title
      h1.main-title
        | NYONDO 
        span STORE
      // Tagline
      .tagline
        | PRECISION MANAGEMENT SYSTEM
      // Gold Divider
      .gold-divider
      // Description
      p.description
        | Precision Management for Nyondo Hardware &mdash; Track stock, manage credit, record sales, and handle deposits with enterprise-grade accuracy.
      // CTA Buttons
      .d-flex.gap-3.justify-content-center.flex-wrap
        a.btn.btn-get-started(href='login.html')
          i.bi.bi-rocket-takeoff.me-2
          |  GET STARTED NOW
        a.btn.btn-access(href='#features')
          | Access Dashboard 
          i.bi.bi-arrow-right.ms-2
// Footer
footer.text-center.py-4(style='position: relative; z-index: 10; background: rgba(0,0,0,0.3);')
  .container
    p.text-white-50.small.mb-0
      i.bi.bi-shield-check
      |  NyondoStock &mdash; Enterprise Hardware Management System
    p.text-white-50.small.mb-0.mt-2
      | &copy; 2026 Nyondo General Hardware LTD. All rights reserved.
script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js')
