doctype html
head
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1.0')
  title NyondoStock - User Management
  // Bootstrap 5 CSS + Icons
  link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css' rel='stylesheet')
  link(rel='stylesheet' href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css')
  // External CSS
  link(rel='stylesheet' href='/css/user_mgt.css')

// ========== SIDEBAR ==========
.sidebar
  .sidebar-logo
    img(src='/images/logo.png' alt='NyondoStock Logo')
    h3 NyondoStock
    p Hardware Management
  ul.nav-menu
    li.nav-item
      a.nav-link-custom(href='/admin')
        i.bi.bi-speedometer2
        |  Dashboard
    li.nav-item
      a.nav-link-custom(href='#')
        i.bi.bi-box-seam
        |  Stock Management
    li.nav-item
      a.nav-link-custom(href='#')
        i.bi.bi-cart-plus
        |  Sales Recording
    li.nav-item
      a.nav-link-custom(href='#')
        i.bi.bi-clock-history
        |  Sales History
    li.nav-item
      a.nav-link-custom(href='#')
        i.bi.bi-credit-card
        |  Supplier Credit
    li.nav-item
      a.nav-link-custom(href='/scheme')
        i.bi.bi-piggy-bank
        |  Deposit Scheme
    li.nav-item
      a.nav-link-custom(href='#')
        i.bi.bi-bar-chart-steps
        |  Reports
    li.nav-item
      a.nav-link-custom.active(href='/users')
        i.bi.bi-people
        |  User Management
  .sidebar-user
    .user-name
      i.bi.bi-person-circle
      |  Admin User 
      span.role-badge Admin
    .user-role System Administrator
    a(href='/logout')
      button.logout-btn
        i.bi.bi-box-arrow-right
        |  Sign Out

// ========== MAIN CONTENT ==========
.main-content
  // Page Header
  .d-flex.justify-content-between.align-items-center.flex-wrap.mb-4
    div
      h3.page-title User Management
      p.page-subtitle Manage system users — add, edit, delete, and assign roles.
    a(href='/register' style='text-decoration: none;')
      button.btn-save Add New User


  // Users Table
  .section-title
    i.bi.bi-list-ul
    |  System Users
  .custom-table
    table
      thead
        tr
          th Full Name
          th Email
          th Phone Number
          th Role
          th Date
          th Actions
      tbody
        each user in users
          tr
            td #{user.fullname}
            td #{user.email}
            td #{user.phonenumber}
            td #{user.role}
            td #{user.Date ? new Date(user.Date).toLocaleDateString() : 'No date'}
            td.actions-cell
              a.btn-edit(href=`/edit-user/${user._id}`) Edit
              form(action=`/delete-user/${user._id}` method='POST' style='display: inline; margin-left: 5px;')
                button.btn-delete(type='submit') Delete

  // Role Description Card
  .form-card.mt-3
    .form-title
      i.bi.bi-info-circle
      |  Role Permissions Overview
    .row.g-3
      .col-md-4
        div
          h6 Administrator
          p Full system access
      .col-md-4
        div
          h6 Store Manager
          p Manage stock,  sales
      .col-md-4
        div
          h6 Sales Attendant
          p Record sales, view stock, process payments — no editing or deletion rights.

.footer
  i.bi.bi-shield-check
  |  NyondoStock — Enterprise Hardware Management System

script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js')