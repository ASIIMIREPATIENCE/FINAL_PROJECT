doctype html
html(lang='en')
head
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1.0')
  title NyondoStock - User Management
  // Bootstrap 5 CSS + Icons
  link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css' rel='stylesheet')
  link(rel='stylesheet' href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css')
  // External CSS
  link(rel='stylesheet' href='/css/user_mgt.css')

body
  // ========== SIDEBAR ==========
  .sidebar
    .sidebar-logo
      img(src='/images/logo.png' alt='NyondoStock Logo')
      h3 NyondoStock
      p Hardware Management

    // Back Button
    .sidebar-back-btn
      button.btn-back(onclick="history.back()")
        i.bi.bi-arrow-left
        | Back

    // Add New User Button - Moved to Sidebar
    .sidebar-add-user
      a(href='/register' style='text-decoration: none;')
        button.btn-save(style='width: 100%;')
          i.bi.bi-person-plus.me-1
          | Add New User

    .sidebar-user
      .user-name
        i.bi.bi-person-circle
        |  #{currentUser ? currentUser.fullname : 'Admin User'} 
        span.role-badge #{currentUser ? (currentUser.role === 'admin' ? 'Admin' : (currentUser.role === 'store_manager' ? 'Manager' : 'Staff')) : 'Admin'}
      .user-role #{currentUser ? (currentUser.role === 'admin' ? 'System Administrator' : (currentUser.role === 'store_manager' ? 'Store Manager' : 'Sales Attendant')) : 'System Administrator'}
      button.logout-btn(onclick="window.location.href='/logout'")
        i.bi.bi-box-arrow-right
        |  Sign Out

  // ========== MAIN CONTENT ==========
  .main-content
    // Page Header
    .d-flex.justify-content-between.align-items-center.flex-wrap.mb-4
      div
        h3.page-title User Management
        p.page-subtitle Manage system users — add, edit, delete, and assign roles.

    // Users Table
    .section-title
      i.bi.bi-list-ul
      |  System Users
    .custom-table
      table
        thead
          tr
            th Full Name
            th Email
            th Phone Number
            th Role
            th Date Joined
            th Actions
        tbody
          if users && users.length
            each user in users
              tr
                td #{user.fullname}
                td #{user.email}
                td #{user.phonenumber}
                td
                  if user.role === 'admin'
                    span.badge(style='background: #0D3B2E; color: white; padding: 5px 10px; border-radius: 5px;') Administrator
                  else if user.role === 'store_manager'
                    span.badge(style='background: #C6A43F; color: #0D3B2E; padding: 5px 10px; border-radius: 5px;') Store Manager
                  else
                    span.badge(style='background: #2E7D64; color: white; padding: 5px 10px; border-radius: 5px;') Sales Attendant
                td #{user.Date ? new Date(user.Date).toLocaleDateString() : 'No date'}
                td.actions-cell
                  a.btn-edit(href=`/edit-user/${user._id}`)
                    i.bi.bi-pencil
                    | Edit
                  form(action=`/delete-user/${user._id}` method='POST' style='display: inline; margin-left: 5px;' onsubmit='return confirm("Are you sure you want to delete this user?")')
                    button.btn-delete(type='submit')
                      i.bi.bi-trash
                      | Delete
          else
            tr
              td.text-center(colspan='6') No users found

    // Role Description Card
    .form-card.mt-3
      .form-title
        i.bi.bi-info-circle
        |  Role Permissions Overview
      .row.g-3
        .col-md-4
          div
            h6 👑 Administrator
            p Full system access — can manage users, stock, sales, deposits, credit, and reports.
        .col-md-4
          div
            h6 📦 Store Manager
            p Manage stock, sales, deposits, credit, and view reports — cannot manage users.
        .col-md-4
          div
            h6 🛒 Sales Attendant
            p Record sales, view stock, process payments, and record deposits — no editing or deletion rights.

  .footer
    i.bi.bi-shield-check
    |  NyondoStock — Enterprise Hardware Management System

  script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js')