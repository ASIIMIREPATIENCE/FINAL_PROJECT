doctype html
head
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1.0')
  title NyondoStock - User Management
  // Bootstrap 5 CSS + Icons
  link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css' rel='stylesheet')
  link(rel='stylesheet' href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css')
  // External CSS
  link(rel='stylesheet' href='/css/user_mgt.css')
// ========== SIDEBAR ==========
.sidebar
  .sidebar-logo
    img(src='/images/logo.png' alt='NyondoStock Logo')
    h3 NyondoStock
    p Hardware Management
  ul.nav-menu
    li.nav-item
      a.nav-link-custom(href='#')
        i.bi.bi-speedometer2
        |  Dashboard
    li.nav-item
      a.nav-link-custom(href='#')
        i.bi.bi-box-seam
        |  Stock Management
    li.nav-item
      a.nav-link-custom(href='#')
        i.bi.bi-cart-plus
        |  Sales Recording
    li.nav-item
      a.nav-link-custom(href='#')
        i.bi.bi-clock-history
        |  Sales History
    li.nav-item
      a.nav-link-custom(href='#')
        i.bi.bi-credit-card
        |  Supplier Credit
    li.nav-item
      a.nav-link-custom(href='#')
        i.bi.bi-piggy-bank
        |  Deposit Scheme
    li.nav-item
      a.nav-link-custom(href='#')
        i.bi.bi-bar-chart-steps
        |  Reports
    li.nav-item
      a.nav-link-custom.active(href='#')
        i.bi.bi-people
        |  User Management
  .sidebar-user
    .user-name
      i.bi.bi-person-circle
      |  Admin User 
      span.role-badge Admin
    .user-role System Administrator
    button.logout-btn
      i.bi.bi-box-arrow-right
      |  Sign Out
// ========== MAIN CONTENT ==========
.main-content
  // Page Header
  .d-flex.justify-content-between.align-items-center.flex-wrap.mb-4
    div
      h3.page-title User Management
      p.page-subtitle Manage system users &mdash; add, edit, delete, and assign roles.
  
  // User Statistics Cards
  .row.g-3.mb-4
    .col-md-3
      .stat-card.stat-total
        .stat-label Total Users
        .stat-value= totalUsers
        small Active system accounts
    .col-md-3
      .stat-card.stat-admin
        .stat-label Administrators
        .stat-value= adminCount
        small Full system access
    .col-md-3
      .stat-card.stat-manager
        .stat-label Store Managers
        .stat-value= managerCount
        small Inventory &amp; sales access
    .col-md-3
      .stat-card.stat-attendant
        .stat-label Sales Attendants
        .stat-value= attendantCount
        small Point of sale access
  
  // Users Table
  .section-title
    i.bi.bi-list-ul
    |  System Users
  .custom-table
    table
      thead
        tr
          th Full Name
          th Email
          th Phone Number
          th Role
          th Date
          th Actions
      tbody
        each user in users
          tr
            td #{user.fullname}
            td #{ user.email}
            td #{user.phonenumber}
            td  #{user.role}
            td #{user.Date ? new Date(user.Date).toLocaleDateString() : 'No date'}
            td.actions-cell
              button.btn-edit
                i.bi.bi-pencil
                |  Edit
              button.btn-delete
                i.bi.bi-trash
                |  Del
  
  // Role Description Card
  .form-card.mt-3
    .form-title
      i.bi.bi-info-circle(style='color: #C6A43F;')
      |  Role Permissions Overview
    .row.g-3
      .col-md-4
        div(style='background: #f8f9fa; border-radius: 12px; padding: 12px;')
          h6(style='color: #0D3B2E; font-weight: 700;')
            i.bi.bi-shield-lock
            |  Administrator
          p(style='font-size: 0.7rem; color: #6c757d; margin: 0;') Full system access &mdash; manage users, stock, sales, credit, deposits, and reports.
      .col-md-4
        div(style='background: #f8f9fa; border-radius: 12px; padding: 12px;')
          h6(style='color: #0D3B2E; font-weight: 700;')
            i.bi.bi-graph-up
            |  Store Manager
          p(style='font-size: 0.7rem; color: #6c757d; margin: 0;')
            | Manage stock, record sales, view reports &mdash; no user management or financial modules.
      .col-md-4
        div(style='background: #f8f9fa; border-radius: 12px; padding: 12px;')
          h6(style='color: #0D3B2E; font-weight: 700;')
            i.bi.bi-cart
            |  Sales Attendant
          p(style='font-size: 0.7rem; color: #6c757d; margin: 0;') Record sales, view stock, process payments &mdash; no editing or deletion rights.

.footer
  i.bi.bi-shield-check
  |  NyondoStock &mdash; Enterprise Hardware Management System

script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js')