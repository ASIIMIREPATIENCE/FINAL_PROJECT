doctype html
html(lang='en')
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    title NyondoStock - Sales Attendant Dashboard
    link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css' rel='stylesheet')
    link(rel='stylesheet' href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css')
    link(rel='stylesheet' href='/css/sales_dashboard.css')

  body
    .sidebar
      .logo
        img(src='/images/logo.png' alt='Logo')
        h4 NyondoStock
        p Hardware Management
      
      .sidebar-back-btn
        button.btn-back(onclick="history.back()")
          i.bi.bi-arrow-left
          | Back
      
      .sidebar-sale-btn
        a(href='/sale' style='text-decoration: none;')
          button.quick-sale-btn
            i.bi.bi-cart-plus
            | NEW SALE
      
      .user-section
        .user-name 👤 #{currentUser ? currentUser.fullname : 'Sales Attendant'}
        .user-role Sales Attendant
        button.logout-btn(onclick="window.location.href='/logout'")
          i.bi.bi-box-arrow-right
          | Sign Out

    .main-content
      .d-flex.justify-content-between.align-items-center.flex-wrap.mb-3
        div
          h3(style='color: #0D3B2E; font-weight: 700; margin: 0;') Sales Dashboard
          p(style='color: #6c757d; margin: 5px 0 0 0; font-size: 0.8rem;') Welcome back, #{currentUser ? currentUser.fullname : 'Sales Attendant'}
      
      if success === 'true'
        .alert.alert-success.alert-dismissible.fade.show(role='alert')
          i.bi.bi-check-circle-fill.me-2
          strong Sale completed successfully!
          button.btn-close(type='button' data-bs-dismiss='alert')
      
      if success === 'deleted'
        .alert.alert-warning.alert-dismissible.fade.show(role='alert')
          i.bi.bi-exclamation-triangle-fill.me-2
          strong Sale deleted and stock restored!
          button.btn-close(type='button' data-bs-dismiss='alert')
      
      if error
        .alert.alert-danger.alert-dismissible.fade.show(role='alert')
          i.bi.bi-exclamation-triangle-fill.me-2
          strong #{error}
          button.btn-close(type='button' data-bs-dismiss='alert')
      
      // STATS CARDS
      .row.g-3.mb-4
        .col-md-4.col-sm-6
          .stat-card
            .stat-value UGX #{todaysSalesTotal ? todaysSalesTotal.toLocaleString() : '0'}
            .stat-label Today's Sales
        .col-md-4.col-sm-6
          .stat-card
            .stat-value #{todaysTransactions || 0}
            .stat-label Today's Transactions
        .col-md-4.col-sm-6
          .stat-card
            .stat-value #{lowStockCount + criticalStockCount || 0}
            .stat-label Low Stock Alerts
      
      // STOCK ALERTS TABLE
      .section-title
        i.bi.bi-exclamation-triangle
        | Stock Alerts
      .custom-table
        table.stock-table
          thead
            tr
              th Date
              th Product Name
              th Current Stock
              th Reorder Level
              th Selling Price
              th Supplier
              th Attendant
          tbody
            if stockItems && stockItems.length
              each item in stockItems
                - var isLowStock = item.quantity <= item.reorderlevel
                - var isCriticalStock = item.quantity <= (item.reorderlevel / 2)
                - var rowClass = ''
                - var stockNumberClass = 'stock-number-normal'
                
                if isCriticalStock
                  - rowClass = 'critical-stock-row'
                  - stockNumberClass = 'stock-number-critical'
                else if isLowStock
                  - rowClass = 'low-stock-row'
                  - stockNumberClass = 'stock-number-low'
                
                tr(class=rowClass)
                  td #{item.Date ? new Date(item.Date).toLocaleDateString() : 'No date'}
                  td 
                    strong #{item.productname || 'Unknown product'}
                    if isCriticalStock
                      span.badge-critical CRITICAL!
                    else if isLowStock
                      span.badge-low LOW STOCK!
                  td
                    span(class=stockNumberClass) #{item.quantity || 0}
                  td #{item.reorderlevel || 'N/A'}
                  td #{item.sellingprice ? 'UGX ' + item.sellingprice.toLocaleString() : 'N/A'}
                  td #{item.supplierCompany || item.supplier || 'N/A'}
                  td #{item.attendantName || 'unknown attendant'}
            else
              tr
                td.text-center(colspan='7') No stock items found
      
      // RECENT SALES TABLE
      .section-title
        i.bi.bi-clock-history
        | Recent Sales
      .custom-table
        table.sales-table
          thead
            tr
              th Date
              th Customer
              th Items
              th Total
              th Payment
              th Attendant
              th Actions
          tbody
            if allSales && allSales.length
              each sale in allSales
                tr
                  td #{sale.Date ? new Date(sale.Date).toLocaleDateString() : 'No date'}
                  td #{sale.customername || 'Walk-in Customer'}
                  td.items-cell
                    if sale.items && sale.items.length
                      - var itemNames = sale.items.map(function(item) { return item.productname; }).join(', ');
                      | #{itemNames}
                    else
                      | -
                  td UGX #{sale.grandTotal ? sale.grandTotal.toLocaleString() : '0'}
                  td 
                    span.badge(style='background: #0D3B2E; color: white; padding: 5px 12px; border-radius: 30px;') #{sale.paymentmethod || 'Cash'}
                  td #{sale.attendantName || 'unknown'}
                  td
                    .action-buttons(style='display: flex; gap: 5px; flex-wrap: wrap;')
                      a.btn-view-receipt(href=`/receipt/${sale._id}` target='_blank')
                        i.bi.bi-receipt
                        | Receipt
                      a.btn-edit-sale(href=`/editSale/${sale._id}`)
                        i.bi.bi-pencil
                        | Edit
                      form(action=`/deleteSale/${sale._id}` method='POST' style='display: inline;' onsubmit='return confirm("⚠️ WARNING: This will DELETE the sale and RESTORE stock quantities. Are you sure?")')
                        button.btn-delete-sale(type='submit')
                          i.bi.bi-trash
                          | Delete
            else
              tr
                td.text-center(colspan='7') No sales found

    .footer
      i.bi.bi-shield-check
      | NyondoStock &mdash; Enterprise Hardware Management System

    script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js')