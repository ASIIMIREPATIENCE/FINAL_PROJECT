doctype html
html(lang='en')
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    title NyondoStock - Sales Attendant Dashboard
    link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css' rel='stylesheet')
    link(rel='stylesheet' href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css')
    link(rel='stylesheet' href='/css/sales_dashboard.css')
    style.
      .sidebar-back-btn, .sidebar-sale-btn {
        padding: 0 15px 15px 15px;
        border-bottom: 1px solid rgba(255,255,255,0.1);
        margin-bottom: 15px;
      }
      .btn-back, .quick-sale-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        background: rgba(255,255,255,0.1);
        border: none;
        color: white;
        padding: 10px 12px;
        border-radius: 8px;
        width: 100%;
        cursor: pointer;
        transition: all 0.2s ease;
        font-size: 0.85rem;
      }
      .btn-back:hover, .quick-sale-btn:hover {
        background: rgba(255,255,255,0.2);
      }
      .quick-sale-btn {
        background: #C6A43F;
        color: #0D3B2E;
      }
      .quick-sale-btn:hover {
        background: #b8922e;
      }

  body
    // SIDEBAR
    .sidebar
      .logo
        img(src='/images/logo.png' alt='Logo')
        h4 NyondoStock
        p Hardware Management

      // Back Button
      .sidebar-back-btn
        button.btn-back(onclick="history.back()")
          i.bi.bi-arrow-left
          | Back

      // Add New Sale Button in Sidebar
      .sidebar-sale-btn
        a(href='/sale' style='text-decoration: none;')
          button.quick-sale-btn
            i.bi.bi-cart-plus.fs-4.me-2
            | NEW SALE

      .user-section
        .user-name 👤 #{currentUser ? currentUser.fullname : 'Sales Attendant'}
        .user-role #{currentUser ? (currentUser.role === 'sales_attendant' ? 'Sales Attendant' : currentUser.role.replace('_', ' ')) : 'Sales Attendant'}
        button.logout-btn(onclick="window.location.href='/logout'")
          i.bi.bi-box-arrow-right
          | Sign Out

    // MAIN CONTENT 
    .main-content
      // Welcome Row
      .row.mb-4
        .col-12
          h4(style='color: var(--nyondo-green);') Welcome back, #{currentUser ? currentUser.fullname : 'Sales Attendant'}!
          p(style='color: #6c757d;') Ready to serve customers today.
      
      // Low Stock Alerts Table
      .section-title
        | Stock 
      .table-responsive.custom-table.mb-4
        table.table.mb-0
          thead
            tr
              th Date
              th Product Name
              th Current Stock
              th Reorder Level
              th Selling Price
              th Supplier Company
              th Attendant
          tbody
            if stockItems && stockItems.length
              each item in stockItems
                - var isLowStock = item.quantity <= item.reorderlevel
                - var isCriticalStock = item.quantity <= (item.reorderlevel / 2)
                - var rowClass = ''
                - var stockNumberClass = 'stock-number-normal'
                
                if isCriticalStock
                  - rowClass = 'critical-stock-row'
                  - stockNumberClass = 'stock-number-critical'
                else if isLowStock
                  - rowClass = 'low-stock-row'
                  - stockNumberClass = 'stock-number-low'
                
                tr(class=rowClass)
                  td #{item.Date ? new Date(item.Date).toLocaleDateString() : 'No date'}
                  td 
                    strong #{item.productname || 'Unknown product'}
                    if isCriticalStock
                      span.badge-critical.ms-2 CRITICAL!
                    else if isLowStock
                      span.badge-low.ms-2 LOW STOCK!
                  td
                    span(class=stockNumberClass) #{item.quantity || 0}
                    if isCriticalStock
                      i.bi.bi-exclamation-triangle.warning-icon(style='color: #9E3C2A; margin-left: 5px;')
                    else if isLowStock
                      i.bi.bi-exclamation-circle.warning-icon(style='color: #C6A43F; margin-left: 5px;')
                  td #{item.reorderlevel || 'N/A'}
                  td #{item.sellingprice ? 'UGX ' + item.sellingprice.toLocaleString() : 'N/A'}
                  td #{item.supplierCompany || item.supplier || 'N/A'}
                  td #{item.attendantName || 'unknown attendant'}
            else
              tr
                td.text-center(colspan='7') No stock items found
      
      // Recent Sales Table
      .row.g-3.mt-2
        .col-lg-12
          .section-title
            i.bi.bi-clock-history
            | Recent Sales
          .custom-table
            table.table.mb-0
              thead
                tr
                  th Date
                  th Customer Name
                  th Products
                  th Total
                  th Payment Method
                  th Attendant
              tbody
                if allSales && allSales.length
                  each sale in allSales.slice(0, 10)
                    tr
                      td #{sale.Date ? new Date(sale.Date).toLocaleDateString() : 'No date'}
                      td #{sale.customername || 'Walk-in Customer'}
                      td 
                        if sale.items && sale.items.length
                          each item, index in sale.items.slice(0, 2)
                            | #{item.productname}
                            if index < sale.items.slice(0, 2).length - 1
                              | , 
                          if sale.items.length > 2
                            |  +#{sale.items.length - 2} more
                        else
                          | Unknown
                      td UGX #{sale.grandTotal ? sale.grandTotal.toLocaleString() : '0'}
                      td 
                        span.badge(style='background: #0D3B2E; color: white; padding: 3px 8px; border-radius: 30px;') #{sale.paymentmethod || 'Cash'}
                      td #{sale.attendantName || 'unknown'}
                else
                  tr
                    td.text-center(colspan='6') No sales found

    // Footer
    .footer
      i.bi.bi-shield-check
      | NyondoStock &mdash; Enterprise Hardware Management System

    script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js')