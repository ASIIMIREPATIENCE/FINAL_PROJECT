doctype html
html(lang='en')
head
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1.0')
  title NyondoStock - Supplier Credit Management
  
  // Bootstrap 5 CSS + Icons
  link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css' rel='stylesheet')
  link(rel='stylesheet' href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css')
  link(rel='stylesheet' href='/css/supplier_credit.css')

body
  // ========== SIDEBAR ==========
  .sidebar
    .sidebar-logo
      img(src='/images/logo.png' alt='Logo')
      h3 NyondoStock
      p Hardware Management
    
    ul.nav-menu
      li.nav-item
        a.nav-link-custom(href='#')
          i.bi.bi-speedometer2
          |  Dashboard
      li.nav-item
        a.nav-link-custom(href='#')
          i.bi.bi-box-seam
          |  Stock Management
      li.nav-item
        a.nav-link-custom(href='#')
          i.bi.bi-cart-plus
          |  Sales Recording
      li.nav-item
        a.nav-link-custom(href='#')
          i.bi.bi-clock-history
          |  Sales History
      li.nav-item
        a.nav-link-custom.active(href='#')
          i.bi.bi-credit-card
          |  Supplier Credit
      li.nav-item
        a.nav-link-custom(href='#')
          i.bi.bi-piggy-bank
          |  Deposit Scheme
      li.nav-item
        a.nav-link-custom(href='#')
          i.bi.bi-bar-chart-steps
          |  Reports
      li.nav-item
        a.nav-link-custom(href='#')
          i.bi.bi-people
          |  User Management
    
    .sidebar-user
      .user-name
        | 👤 Admin User 
        span.role-badge Admin
      .user-role System Administrator
      button.logout-btn
        i.bi.bi-box-arrow-right
        |  Sign Out

  // ========== MAIN CONTENT ==========
  .main-content
    
    .d-flex.justify-content-between.align-items-center.flex-wrap.mb-3
      div
        h3(style='color: var(--nyondo-green); font-weight: 700; margin: 0;') Supplier Credit Management
        p(style='color: #6c757d; margin: 5px 0 0 0; font-size: 0.8rem;') Track credit given to suppliers and manage payment schedules.
      div
        a(href='/stock' style='text-decoration: none;')
          button.btn-save(style='padding: 8px 20px;')
            i.bi.bi-box-seam
            |  View Stock
    
    // Summary Cards
    .row.g-3.mb-4
      .col-md-4
        .summary-card
          div(style='font-size: 0.7rem; opacity: 0.8;') Total Outstanding Credit
          .summary-value UGX #{totalOutstanding ? totalOutstanding.toLocaleString() : '0'}
          small(style='opacity: 0.7;') Across #{uniqueSuppliers} suppliers
      .col-md-4
        .summary-card(style='background: linear-gradient(135deg, #C6A43F 0%, #B8922E 100%);')
          div(style='font-size: 0.7rem; opacity: 0.8;') Due Within 7 Days
          .summary-value(style='color: #0D3B2E;') UGX #{dueWithin7Days ? dueWithin7Days.toLocaleString() : '0'}
          small(style='opacity: 0.8;') #{dueWithin7DaysCount} payment(s) due soon
      .col-md-4
        .summary-card(style='background: linear-gradient(135deg, #9E3C2A 0%, #7a2e1f 100%);')
          div(style='font-size: 0.7rem; opacity: 0.8;') Overdue Payments
          .summary-value UGX #{overdueTotal ? overdueTotal.toLocaleString() : '0'}
          small(style='opacity: 0.8;') #{overdueCount} overdue payment(s)
    
    // Outstanding Credit Table
    .section-title
      i.bi.bi-list-ul
      |  Outstanding Credit from Stock Purchases
    .custom-table
      table
        thead
          tr
            th Supplier
            th Product
            th Amount Owed
            th Stock Quantity
            th Purchase Date
            th Due Date
            th Status
            th Action
        tbody
          if creditStockItems && creditStockItems.length
            each item in creditStockItems
              tr
                td #{item.supplier || 'N/A'}
                td #{item.productname || 'Unknown'}
                td UGX #{item.balance ? item.balance.toLocaleString() : '0'}
                td #{item.quantity || 0}
                td #{item.Date ? new Date(item.Date).toLocaleDateString() : 'No date'}
                td #{item.dueDate ? new Date(item.dueDate).toLocaleDateString() : 'N/A'}
                td
                  if item.status === 'Overdue'
                    span.badge-overdue Overdue
                  else if item.status === 'Paid'
                    span(style='background-color: #0D3B2E; color: white; padding: 5px 10px; border-radius: 5px;') Paid
                  else
                    span.badge-pending Pending
                td
                  if item.balance > 0
                    a.btn-pay(href=`/payment/${item._id}`)
                      i.bi.bi-cash
                      |  Pay
                  else
                    button.btn-pay(disabled style='opacity: 0.5;')
                      i.bi.bi-check
                      |  Paid
          else
            tr
              td.text-center(colspan='8') No credit stock found. Stock purchased on credit will appear here.
    
  .footer
    i.bi.bi-shield-check
    |  NyondoStock &mdash; Enterprise Hardware Management System

  script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js')